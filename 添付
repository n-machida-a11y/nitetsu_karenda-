function transferAndSplitData() {
  // スプレッドシートをアクティブにする
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  
  // 「貼付」と「確認と修正」シートを取得する
  const sourceSheet = spreadsheet.getSheetByName('貼付');
  let destinationSheet = spreadsheet.getSheetByName('確認と修正');
  
  // 「確認と修正」シートが存在しない場合は作成する
  if (!destinationSheet) {
    destinationSheet = spreadsheet.insertSheet('確認と修正');
  } else {
    // 転記先をリセット（書式も含めてクリア）
    destinationSheet.clear();
  }
  
  // 「貼付」シートの全データを取得する
  const data = sourceSheet.getDataRange().getValues();
  
  // データがない場合（空行のみの場合含む）の処理
  if (data.length === 0 || (data.length === 1 && data[0][0] === "")) {
    spreadsheet.toast('「貼付」シートにデータが見つかりませんでした。', 'エラー', 5);
    return;
  }

  // 転記する新しいデータ配列を準備する
  const newData = [];
  let maxColumns = 5; // 基本は5列(id, title, start, end, client)を想定

  // 1. データを分割し、不要なダブルクォーテーションを除去する
  for (let i = 0; i < data.length; i++) {
    const rawValue = data[i][0].toString();
    if (!rawValue) continue; // 空行はスキップ
    
    // カンマで分割し、各項目の前後の " を削除
    let row = rawValue.split(',').map(item => item.replace(/^"|"$/g, '').trim());
    newData.push(row);
    
    // 最大列数を記録（データによって列が増減する場合に対応）
    if (row.length > maxColumns) {
      maxColumns = row.length;
    }
  }

  // 2. すべての行の列数を揃える（エラー防止策）
  // 列が足りない行は空白で埋め、スプレッドシートの矩形範囲エラーを防ぐ
  const rectangularData = newData.map(row => {
    while (row.length < maxColumns) {
      row.push(""); 
    }
    return row.slice(0, maxColumns);
  });
  
  // 3. データの書き込み
  if (rectangularData.length > 0) {
    const range = destinationSheet.getRange(1, 1, rectangularData.length, maxColumns);
    range.setValues(rectangularData);
    
    // 4. 書式の設定（視認性向上）
    // ヘッダー行（1行目）を装飾
    const headerRange = destinationSheet.getRange(1, 1, 1, maxColumns);
    headerRange.setFontWeight('bold')
               .setBackground('#EFEFEF')
               .setBorder(true, true, true, true, true, true, '#999999', SpreadsheetApp.BorderStyle.SOLID);
    
    // 1行目を固定表示
    destinationSheet.setFrozenRows(1);
    
    // 列幅を内容に合わせて自動調整
    destinationSheet.autoResizeColumns(1, maxColumns);
    
    // ★重要: 処理完了後に元の「貼付」シートを自動クリア
    sourceSheet.clear();

    // 完了メッセージ
    SpreadsheetApp.getUi().alert('転記が完了しました。\n「確認と修正」シートに移動し作業してください。');
  } else {
    spreadsheet.toast('有効なデータがありませんでした。', '警告');
  }
}
