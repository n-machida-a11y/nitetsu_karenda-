      <label class="d-flex align-items-center gap-1 mb-2" style="font-size:0.85rem;cursor:pointer;">
        <input type="radio" name="eu_viewMode" value="all" ${viewAll ? 'checked' : ''}
          onchange="document.getElementById('eu_viewChecks').classList.add('d-none')">
        全エリアを表示
