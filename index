function handleAttachmentUpload() {
  const fileInput = document.getElementById('attachFileInput');
  const memo      = document.getElementById('attachMemoInput').value.trim();
  const statusEl  = document.getElementById('attachUploadStatus');
  if (!fileInput.files || fileInput.files.length === 0) {
    statusEl.textContent = 'ファイルを選択してください';
    statusEl.className = 'text-danger small mt-1';
    return;
  }
  const file = fileInput.files[0];
  if (file.size > 8 * 1024 * 1024) {
    statusEl.textContent = 'ファイルサイズは8MB以下にしてください';
    statusEl.className = 'text-danger small mt-1';
    return;
  }
  statusEl.textContent = 'アップロード中...';
  statusEl.className = 'text-muted small mt-1';
  document.getElementById('attachUploadBtn').disabled = true;
  const reader = new FileReader();
  reader.onload = e => {
    const base64Data = e.target.result.split(',')[1];
    google.script.run
      .withSuccessHandler(result => {
        document.getElementById('attachUploadBtn').disabled = false;
        if (result.status === 'success') {
          statusEl.textContent = '';
          document.getElementById('attachFileInput').value = '';
          document.getElementById('attachMemoInput').value = '';
          attachmentClients.add(attachmentModalClient);
          renderSidebar();
          google.script.run
            .withSuccessHandler(files => renderAttachmentList(files))
            .withFailureHandler(() => {})
            .getAttachments(attachmentModalClient);
        } else {
          statusEl.textContent = 'エラー: ' + result.message;
          statusEl.className = 'text-danger small mt-1';
        }
      })
      .withFailureHandler(err => {
        document.getElementById('attachUploadBtn').disabled = false;
        statusEl.textContent = 'エラー: ' + (err.message || err);
        statusEl.className = 'text-danger small mt-1';
      })
      .uploadAttachment({
        clientName: attachmentModalClient,
        fileName:   file.name,
        mimeType:   file.type || 'application/octet-stream',
        base64Data: base64Data,
        memo:       memo
      });
  };
  reader.readAsDataURL(file);
}

function deleteAttachmentItem(id, fileName) {
