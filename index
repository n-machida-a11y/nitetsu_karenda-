      </div>
    </div>
    <div class="border rounded p-2">
      <div class="form-label form-label-sm fw-bold mb-2">編集エリア</div>
      <div id="eu_editContent">
        ${isAdmin
          ? '<div class="text-success py-1" style="font-size:0.85rem;">★ 管理者は全エリアを編集できます</div>'
          : `<label class="d-flex align-items-center gap-1 mb-2" style="font-size:0.85rem;cursor:pointer;">
              <input type="radio" name="eu_editMode" value="none" ${editNone ? 'checked' : ''}
                onchange="document.getElementById('eu_editChecks').classList.add('d-none')">
              編集不可（閲覧のみ）
