function showEventPopover(info) {
  const ev    = info.event;
  const props = ev.extendedProps || {};
  popoverEventId  = ev.id;
  popoverEventObj = ev;

  document.getElementById('eventPopoverClient').textContent = props.clientName || '';
  const input = document.getElementById('eventPopoverInput');
  input.value = ev.title;

  // 位置計算（ビューポート境界を考慮）
  const W = 260, H = 130;
  const vw = window.innerWidth, vh = window.innerHeight;
  let left = info.jsEvent.clientX + 12;
  let top  = info.jsEvent.clientY + 12;
  if (left + W > vw - 8) left = info.jsEvent.clientX - W - 12;
  if (top  + H > vh - 8) top  = info.jsEvent.clientY - H - 12;

  const pop = document.getElementById('eventPopover');
  pop.style.left    = left + 'px';
  pop.style.top     = top  + 'px';
  pop.style.display = '';
  setTimeout(() => { input.focus(); input.select(); }, 30);
}

function closeEventPopover() {
  document.getElementById('eventPopover').style.display = 'none';
  popoverEventId  = null;
  popoverEventObj = null;
}

function saveEventTitle() {
  const newTitle = document.getElementById('eventPopoverInput').value.trim();
  if (!newTitle) { showAlert('イベント名を入力してください'); return; }
  if (!popoverEventId) return;
  const id = popoverEventId;
  showLoading(true);
  google.script.run
    .withSuccessHandler(result => {
      showLoading(false);
      if (result.status === 'success') {
        const ev = rawEvents.find(e => String(e.id) === String(id));
        if (ev) ev.title = newTitle;
        calendar.refetchEvents();
        closeEventPopover();
      } else {
        showAlert('保存エラー: ' + result.message);
      }
    })
    .withFailureHandler(err => { showLoading(false); showAlert('保存エラー: ' + (err.message || err)); })
    .updateEventTitle(id, newTitle);
}

function confirmDeleteEventFromPopover() {
  const ev = popoverEventObj;
  const id = popoverEventId;
  if (!ev || !id) return;
  closeEventPopover();
  showConfirm(`「${ev.title}」を削除しますか？`, () => {
    showLoading(true);
    google.script.run
