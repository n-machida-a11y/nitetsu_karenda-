function openSettings() {
  if (!canOpenSettings()) { showAlert('設定を開く権限がありません'); return; }
  refreshSettingsAreaSelects();
  renderClientSettings();
  renderAreaSettings();
  renderPatternSettings();
  if (currentUser && currentUser.isAdmin) {
    google.script.run
      .withSuccessHandler(data => { users = data || []; renderUserSettings(); })
      .withFailureHandler(handleError)
      .getUsers();
  }
  settingsModal.show();
}

/** 設定モーダル内のエリアセレクト・チェックボックスを最新状態に更新 */
function refreshSettingsAreaSelects() {
  const selects = ['newClientArea'];
  selects.forEach(id => {
    const sel = document.getElementById(id);
    if (!sel) return;
    const cur = sel.value;
    sel.innerHTML = '<option value="">未設定</option>';
    areas.forEach(a => {
      const opt = document.createElement('option');
      opt.value = a.id;
      opt.textContent = a.name;
      if (a.id === cur) opt.selected = true;
      sel.appendChild(opt);
    });
  });
  // ユーザー追加フォームの表示エリア・編集エリアチェックボックスを再生成
  ['newUserViewableChecks', 'newUserEditableChecks'].forEach(containerId => {
    const wrap = document.getElementById(containerId);
    if (!wrap) return;
    wrap.innerHTML = areas.map(a =>
      `<label class="d-flex align-items-center gap-1" style="font-size:0.82rem;cursor:pointer;">
        <input type="checkbox" class="${containerId}_cb" value="${escHtml(a.id)}">
        ${escHtml(a.name)}
      </label>`
    ).join('');
  });
}

/** チェックボックスグループからカンマ区切りIDを収集 */
function collectCheckedAreas(containerId) {
  return [...document.querySelectorAll(`#${containerId} input[type=checkbox]:checked`)]
    .map(cb => cb.value).join(',');
}

// ===== 会社管理 =====
function renderClientSettings() {
  const container = document.getElementById('clientSettingsList');
  // 管理者は全社、それ以外は編集エリアに含まれる会社のみ表示
  let visibleForSettings = clients;
  if (!isAdmin() && currentUser) {
    const editList = parseIdList(currentUser.editableAreas);
    if (editList.length > 0) {
      visibleForSettings = clients.filter(c => editList.includes(c.areaId));
    }
  }

  if (visibleForSettings.length === 0) {
    container.innerHTML = '<div class="text-muted small p-3">会社がありません</div>';
    return;
  }
  container.innerHTML = visibleForSettings.map(c => {
    const area = areas.find(a => a.id === c.areaId);
    const clientColor = (c.color && c.color !== '') ? c.color : '#6c757d';
    return `
      <div class="settings-item">
        <div class="color-preview" style="background:${escHtml(clientColor)}"></div>
        <div class="item-name">${escHtml(c.name)}</div>
        <div class="item-meta">${area ? escHtml(area.name) : '未設定'}</div>
        <button class="btn btn-xs btn-outline-secondary btn-sm ms-auto" style="padding:2px 8px;font-size:0.75rem"
          onclick="editClientModal('${escHtml(c.id)}')">編集</button>
        <button class="btn btn-xs btn-outline-danger btn-sm ms-1" style="padding:2px 8px;font-size:0.75rem"
          onclick="deleteClientConfirm('${escHtml(c.id)}','${escHtml(c.name)}')">削除</button>
      </div>
    `;
  }).join('');
}

function handleAddClient() {
  const name = document.getElementById('newClientName').value.trim();
  if (!name) { showAlert('会社名を入力してください'); return; }
  showLoading(true);
  google.script.run
    .withSuccessHandler(result => {
      showLoading(false);
      if (result.status === 'success') {
        document.getElementById('newClientName').value = '';
        document.getElementById('newClientMemo').value = '';
        reloadClients();
      } else { showAlert('追加エラー: ' + result.message); }
    })
    .withFailureHandler(handleError)
    .addClient({
      name,
      memo:   document.getElementById('newClientMemo').value.trim(),
      areaId: document.getElementById('newClientArea').value,
      color:  document.getElementById('newClientColor').value
    });
}

