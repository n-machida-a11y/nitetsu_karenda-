      <label class="d-flex align-items-center gap-1 mb-1" style="font-size:0.85rem;cursor:pointer;">
        <input type="radio" name="eu_viewMode" value="select" ${!viewAll ? 'checked' : ''}
          onchange="document.getElementById('eu_viewChecks').classList.remove('d-none')">
        エリアを選んで表示
