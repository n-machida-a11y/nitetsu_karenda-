function deleteClientConfirm(id, name) {
  showConfirm(`「${name}」を削除しますか？\n（この会社の予定データは残ります）`, () => {
    showLoading(true);
    google.script.run
      .withSuccessHandler(result => {
        showLoading(false);
        if (result.status === 'success') reloadClients();
        else showAlert('削除エラー: ' + result.message);
      })
      .withFailureHandler(handleError)
      .deleteClient(id);
  });
}

function reloadClients() {
  google.script.run
    .withSuccessHandler(data => {
      clients = data || [];
      clientRules = {};
      clients.forEach(c => { if (c.memo && c.memo.trim()) clientRules[c.name] = c.memo.trim(); });
      const clientNames = new Set(clients.map(c => c.name));
      checkedClients = new Set([...checkedClients].filter(n => clientNames.has(n)));
      clients.forEach(c => { if (!checkedClients.has(c.name)) checkedClients.add(c.name); });
      renderSidebar();
      renderClientSettings();
      // イベントの色も再取得
      reloadEvents();
    })
    .withFailureHandler(handleError)
    .getClients();
}

// ===== エリア管理 =====
function renderAreaSettings() {
  const container = document.getElementById('areaSettingsList');
  if (areas.length === 0) {
    container.innerHTML = '<div class="text-muted small p-3">エリアがありません</div>';
    return;
  }
  container.innerHTML = areas.map(a => `
    <div class="settings-item">
      <div class="item-name">${escHtml(a.name)}</div>
      <div class="item-meta ms-auto">
        ${isAdmin() ? `
        <button class="btn btn-xs btn-outline-secondary btn-sm ms-2" style="padding:2px 8px;font-size:0.75rem"
          onclick="editAreaModal('${escHtml(a.id)}','${escHtml(a.name)}')">編集</button>
        <button class="btn btn-xs btn-outline-danger btn-sm ms-1" style="padding:2px 8px;font-size:0.75rem"
          onclick="deleteAreaConfirm('${escHtml(a.id)}','${escHtml(a.name)}')">削除</button>
        ` : ''}
      </div>
    </div>
  `).join('');
}

function handleAddArea() {
  const name = document.getElementById('newAreaName').value.trim();
  if (!name) { showAlert('エリア名を入力してください'); return; }
  showLoading(true);
  google.script.run
    .withSuccessHandler(result => {
      showLoading(false);
      if (result.status === 'success') {
        document.getElementById('newAreaName').value = '';
        reloadAreas();
      } else { showAlert('追加エラー: ' + result.message); }
    })
    .withFailureHandler(handleError)
    .addArea({ name });
}

function editAreaModal(id, name) {
  document.getElementById('editModalTitle').textContent = 'エリアを編集';
  document.getElementById('editModalBody').innerHTML = `
    <div><label class="form-label form-label-sm">エリア名</label>
      <input type="text" id="editAreaName" class="form-control form-control-sm" value="${escHtml(name)}"></div>
  `;
  document.getElementById('editModalSaveBtn').onclick = () => {
    const newName = document.getElementById('editAreaName').value.trim();
    if (!newName) { showAlert('エリア名を入力してください'); return; }
    showLoading(true);
    google.script.run
      .withSuccessHandler(result => {
        showLoading(false);
        editModalBS.hide();
        if (result.status === 'success') reloadAreas();
        else showAlert('更新エラー: ' + result.message);
      })
      .withFailureHandler(handleError)
      .updateArea({ id, name: newName });
  };
  editModalBS.show();
}

function deleteAreaConfirm(id, name) {
  showConfirm(`エリア「${name}」を削除しますか？\n（このエリアに属する会社のエリア設定はクリアされます）`, () => {
    showLoading(true);
    google.script.run
      .withSuccessHandler(result => {
        showLoading(false);
        if (result.status === 'success') reloadAreas();
        else showAlert('削除エラー: ' + result.message);
      })
      .withFailureHandler(handleError)
      .deleteArea(id);
  });
}

function reloadAreas() {
  google.script.run
    .withSuccessHandler(data => {
      areas = data || [];
      // アクティブなエリアが削除されていたら「全て」に戻す
      if (activeAreaId !== '__all__' && !areas.find(a => a.id === activeAreaId)) {
        activeAreaId = '__all__';
      }
      renderAreaTabs();
      renderAreaSettings();
      refreshSettingsAreaSelects();
      renderClientSettings();
      renderSidebar();
    })
    .withFailureHandler(handleError)
    .getAreas();
}

// ===== パターン管理 =====
function renderPatternSettings() {
  const container = document.getElementById('patternSettingsList');
  if (patterns.length === 0) {
    container.innerHTML = '<div class="text-muted small p-3">パターンがありません</div>';
    return;
  }
  container.innerHTML = patterns.map(p => `
    <div class="settings-item">
      <div class="item-name">${escHtml(p.name)}</div>
      <div class="item-meta">${p.startTime === 'allday' ? '終日' : escHtml(p.startTime) + '〜' + escHtml(p.endTime)}</div>
      <button class="btn btn-xs btn-outline-secondary btn-sm ms-2" style="padding:2px 8px;font-size:0.75rem"
        onclick="editPatternModal('${escHtml(p.id)}','${escHtml(p.name)}','${escHtml(p.startTime)}','${escHtml(p.endTime)}','${escHtml(p.color)}',${p.order})">編集</button>
      <button class="btn btn-xs btn-outline-danger btn-sm ms-1" style="padding:2px 8px;font-size:0.75rem"
        onclick="deletePatternConfirm('${escHtml(p.id)}','${escHtml(p.name)}')">削除</button>
    </div>
  `).join('');
}

function handleAddPattern() {
  const name = document.getElementById('newPatternName').value.trim();
  if (!name) { showAlert('パターン名を入力してください'); return; }
  const startTime = document.getElementById('newPatternStart').value;
  const endTime   = startTime === 'allday' ? '' : document.getElementById('newPatternEnd').value;
  const color     = '#6c757d'; // パターン色は固定（得意先色を使用するため）
  showLoading(true);
  google.script.run
    .withSuccessHandler(result => {
      showLoading(false);
      if (result.status === 'success') {
        document.getElementById('newPatternName').value = '';
        reloadPatterns();
      } else { showAlert('追加エラー: ' + result.message); }
    })
    .withFailureHandler(handleError)
    .addPattern({ name, startTime, endTime, color });
}

function editPatternModal(id, name, startTime, endTime, color, order) {
  const isAllday = startTime === 'allday';
  document.getElementById('editModalTitle').textContent = 'パターンを編集';
  document.getElementById('editModalBody').innerHTML = `
    <div class="mb-2"><label class="form-label form-label-sm">パターン名</label>
      <input type="text" id="ep_name" class="form-control form-control-sm" value="${escHtml(name)}"></div>
    <div class="mb-2"><label class="form-label form-label-sm">開始時刻</label>
      <select id="ep_start" class="form-select form-select-sm">
        ${['allday','08:00','09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00','17:00']
          .map(v => `<option value="${v}" ${v===startTime?'selected':''}>${v==='allday'?'終日':v}</option>`).join('')}
      </select></div>
    <div class="mb-2" id="ep_end_wrap" ${isAllday?'style="display:none"':''}>
      <label class="form-label form-label-sm">終了時刻</label>
      <select id="ep_end" class="form-select form-select-sm">
        ${['09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00','17:00','18:00','19:00']
          .map(v => `<option value="${v}" ${v===endTime?'selected':''}>${v}</option>`).join('')}
      </select></div>
    <div><label class="form-label form-label-sm">並び順</label>
      <input type="number" id="ep_order" class="form-control form-control-sm" value="${order}" style="width:80px"></div>
  `;
  document.getElementById('ep_start').addEventListener('change', function() {
    document.getElementById('ep_end_wrap').style.display = this.value === 'allday' ? 'none' : '';
  });
  document.getElementById('editModalSaveBtn').onclick = () => {
    const newName = document.getElementById('ep_name').value.trim();
    if (!newName) { showAlert('パターン名を入力してください'); return; }
    const newStart = document.getElementById('ep_start').value;
    const newEnd   = newStart === 'allday' ? '' : document.getElementById('ep_end').value;
    const newColor = color; // 色はそのまま保持
    const newOrder = parseInt(document.getElementById('ep_order').value) || order;
    showLoading(true);
    google.script.run
      .withSuccessHandler(result => {
        showLoading(false);
        editModalBS.hide();
        if (result.status === 'success') reloadPatterns();
        else showAlert('更新エラー: ' + result.message);
      })
      .withFailureHandler(handleError)
      .updatePattern({ id, name: newName, startTime: newStart, endTime: newEnd, color: newColor, order: newOrder });
  };
  editModalBS.show();
}

function deletePatternConfirm(id, name) {
  showConfirm(`パターン「${name}」を削除しますか？`, () => {
    showLoading(true);
    google.script.run
      .withSuccessHandler(result => {
        showLoading(false);
        if (result.status === 'success') reloadPatterns();
        else showAlert('削除エラー: ' + result.message);
      })
      .withFailureHandler(handleError)
      .deletePattern(id);
  });
}

function reloadPatterns() {
  google.script.run
    .withSuccessHandler(data => {
      patterns = data || [];
      buildPalette();
      renderPatternSettings();
      if (rawEvents.length > 0) calendar.refetchEvents();
    })
    .withFailureHandler(handleError)
    .getPatterns();
}

// ===== ユーザー管理（管理者のみ） =====
function renderUserSettings() {
  const container = document.getElementById('userSettingsList');
  if (users.length === 0) {
    container.innerHTML = '<div class="text-muted small p-3">ユーザーがいません</div>';
    return;
  }
  container.innerHTML = users.map(u => {
    const viewList = parseIdList(u.viewableAreas);
    const editList = parseIdList(u.editableAreas);
    const adminMark = u.isAdmin ? ' ★' : '';
    const viewText = viewList.length === 0 ? '全て'
      : viewList.map(id => { const a = areas.find(x => x.id === id); return a ? a.name : ''; }).filter(Boolean).join(',');
    const editText = editList.length === 0 ? '不可'
      : editList.map(id => { const a = areas.find(x => x.id === id); return a ? a.name : ''; }).filter(Boolean).join(',');
    return `
      <div class="settings-item" style="gap:6px;">
        <div style="flex:0 0 auto;font-size:0.88rem;font-weight:600;">${escHtml(u.name)}${escHtml(adminMark)}</div>
        <div class="item-meta" style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(u.email)}</div>
        <div class="item-meta" style="flex:0 0 auto;font-size:0.75rem;">表示:${escHtml(viewText)}</div>
        <div class="item-meta" style="flex:0 0 auto;font-size:0.75rem;">編集:${escHtml(editText)}</div>
        <button class="btn btn-xs btn-outline-secondary btn-sm" style="flex:0 0 auto;padding:2px 8px;font-size:0.75rem"
          onclick="editUserModal('${escHtml(u.id)}','${escHtml(u.name)}','${escHtml(u.email)}',${!!u.isAdmin},'${escHtml(u.viewableAreas||'')}','${escHtml(u.editableAreas||'')}')">編集</button>
        <button class="btn btn-xs btn-outline-danger btn-sm" style="flex:0 0 auto;padding:2px 8px;font-size:0.75rem"
          onclick="deleteUserConfirm('${escHtml(u.id)}','${escHtml(u.name)}')">削除</button>
      </div>
    `;
  }).join('');
}

function handleAddUser() {
  const name  = document.getElementById('newUserName').value.trim();
  const email = document.getElementById('newUserEmail').value.trim();
  if (!name)  { showAlert('名前を入力してください'); return; }
  if (!email) { showAlert('メールアドレスを入力してください'); return; }
  showLoading(true);
  google.script.run
    .withSuccessHandler(result => {
      showLoading(false);
      if (result.status === 'success') {
        document.getElementById('newUserName').value  = '';
        document.getElementById('newUserEmail').value = '';
        reloadUsers();
      } else { showAlert('追加エラー: ' + result.message); }
    })
    .withFailureHandler(handleError)
    .addUser({
      name,
      email,
      isAdmin:       document.getElementById('newUserIsAdmin').checked,
      viewableAreas: document.querySelector('input[name="newViewMode"]:checked').value === 'all'
                      ? '' : collectCheckedAreas('newUserViewableChecks'),
      // 管理者は editableAreas = ''（全エリア編集可）、それ以外はUIから取得
      editableAreas: (function() {
        if (document.getElementById('newUserIsAdmin').checked) return '';
        const modeEl = document.querySelector('input[name="newEditMode"]:checked');
        if (!modeEl || modeEl.value === 'none') return '';
        return [...document.querySelectorAll('.newUserEditableChecks_cb:checked')].map(cb => cb.value).join(',');
      })()
    });
}

/** 追加フォーム用: 管理者チェックON/OFFで編集エリアセクションを切り替え */
function onNewAdminCheckChange(checked) {
  const content = document.getElementById('newUserEditContent');
  if (!content) return;
  if (checked) {
    content.innerHTML = '<div class="text-success py-1" style="font-size:0.85rem;">★ 管理者は全エリアを編集できます</div>';
  } else {
    const editChecks = areas.map(a =>
      `<label class="d-flex align-items-center gap-1" style="font-size:0.82rem;cursor:pointer;">
        <input type="checkbox" class="newUserEditableChecks_cb" value="${escHtml(a.id)}"> ${escHtml(a.name)}
      </label>`
    ).join('');
    content.innerHTML = `
      <label class="d-flex align-items-center gap-1 mb-1" style="font-size:0.82rem;cursor:pointer;">
        <input type="radio" name="newEditMode" value="none" checked
          onchange="document.getElementById('newUserEditSub').classList.add('d-none')">編集不可
      </label>
      <label class="d-flex align-items-center gap-1 mb-1" style="font-size:0.82rem;cursor:pointer;">
        <input type="radio" name="newEditMode" value="select"
          onchange="document.getElementById('newUserEditSub').classList.remove('d-none')">選んで編集可
      </label>
      <div id="newUserEditSub" class="d-flex flex-wrap gap-2 ps-2 d-none">${editChecks}</div>`;
  }
}

/** 編集モーダル用: 管理者チェックON/OFFで編集エリアセクションを切り替え */
function onAdminCheckChange(checked) {
  const content = document.getElementById('eu_editContent');
  if (!content) return;
  if (checked) {
    content.innerHTML = '<div class="text-success py-1" style="font-size:0.85rem;">★ 管理者は全エリアを編集できます</div>';
  } else {
    const editChecks = areas.map(a =>
      `<label class="d-flex align-items-center gap-1" style="font-size:0.82rem;cursor:pointer;">
        <input type="checkbox" class="eu_editCb" value="${escHtml(a.id)}"> ${escHtml(a.name)}
      </label>`
    ).join('');
    content.innerHTML = `
      <label class="d-flex align-items-center gap-1 mb-2" style="font-size:0.85rem;cursor:pointer;">
        <input type="radio" name="eu_editMode" value="none" checked
          onchange="document.getElementById('eu_editChecks').classList.add('d-none')">
        編集不可（閲覧のみ）
      </label>
      <label class="d-flex align-items-center gap-1 mb-1" style="font-size:0.85rem;cursor:pointer;">
        <input type="radio" name="eu_editMode" value="select"
          onchange="document.getElementById('eu_editChecks').classList.remove('d-none')">
        エリアを選んで編集可
      </label>
      <div id="eu_editChecks" class="d-flex flex-wrap gap-2 ps-3 pt-1 d-none">
        ${editChecks || '<span class="text-muted small">エリアなし</span>'}
      </div>`;
  }
}

function editUserModal(id, name, email, isAdmin, viewableAreas, editableAreas) {
  document.getElementById('editModalTitle').textContent = 'ユーザーを編集';
  const viewList = parseIdList(viewableAreas);
  const editList = parseIdList(editableAreas);
  const viewAll = viewList.length === 0;
  const editNone = editList.length === 0;
  const viewChecks = areas.map(a =>
    `<label class="d-flex align-items-center gap-1" style="font-size:0.82rem;cursor:pointer;">
      <input type="checkbox" class="eu_viewCb" value="${escHtml(a.id)}" ${viewList.includes(a.id) ? 'checked' : ''}>
      ${escHtml(a.name)}
    </label>`
  ).join('');
  const editChecks = areas.map(a =>
    `<label class="d-flex align-items-center gap-1" style="font-size:0.82rem;cursor:pointer;">
      <input type="checkbox" class="eu_editCb" value="${escHtml(a.id)}" ${editList.includes(a.id) ? 'checked' : ''}>
      ${escHtml(a.name)}
    </label>`
  ).join('');

  document.getElementById('editModalBody').innerHTML = `
    <div class="mb-2"><label class="form-label form-label-sm">名前</label>
      <input type="text" id="eu_name" class="form-control form-control-sm" value="${escHtml(name)}"></div>
    <div class="mb-2"><label class="form-label form-label-sm">メールアドレス</label>
      <input type="email" id="eu_email" class="form-control form-control-sm" value="${escHtml(email)}"></div>
    <div class="mb-3">
      <label class="d-flex align-items-center gap-2" style="font-size:0.85rem;cursor:pointer;">
        <input type="checkbox" id="eu_isAdmin" ${isAdmin ? 'checked' : ''}
          onchange="onAdminCheckChange(this.checked)">
        管理者権限（設定・ユーザー管理にアクセス可）
      </label>
    </div>
    <div class="mb-2 border rounded p-2">
      <div class="form-label form-label-sm fw-bold mb-2">表示エリア <span class="text-muted" style="font-size:0.75rem;">（未選択=全て表示）</span></div>
      <label class="d-flex align-items-center gap-1 mb-2" style="font-size:0.85rem;cursor:pointer;">
        <input type="radio" name="eu_viewMode" value="all" ${viewAll ? 'checked' : ''}
          onchange="document.getElementById('eu_viewChecks').classList.add('d-none')">
        全エリアを表示
      </label>
      <label class="d-flex align-items-center gap-1 mb-1" style="font-size:0.85rem;cursor:pointer;">
        <input type="radio" name="eu_viewMode" value="select" ${!viewAll ? 'checked' : ''}
          onchange="document.getElementById('eu_viewChecks').classList.remove('d-none')">
        エリアを選んで表示
      </label>
      <div id="eu_viewChecks" class="d-flex flex-wrap gap-2 ps-3 pt-1 ${viewAll ? 'd-none' : ''}">
        ${viewChecks || '<span class="text-muted small">エリアなし</span>'}
      </div>
    </div>
    <div class="border rounded p-2">
      <div class="form-label form-label-sm fw-bold mb-2">編集エリア</div>
      <div id="eu_editContent">
        ${isAdmin
          ? '<div class="text-success py-1" style="font-size:0.85rem;">★ 管理者は全エリアを編集できます</div>'
          : `<label class="d-flex align-items-center gap-1 mb-2" style="font-size:0.85rem;cursor:pointer;">
              <input type="radio" name="eu_editMode" value="none" ${editNone ? 'checked' : ''}
                onchange="document.getElementById('eu_editChecks').classList.add('d-none')">
              編集不可（閲覧のみ）
            </label>
            <label class="d-flex align-items-center gap-1 mb-1" style="font-size:0.85rem;cursor:pointer;">
              <input type="radio" name="eu_editMode" value="select" ${!editNone ? 'checked' : ''}
                onchange="document.getElementById('eu_editChecks').classList.remove('d-none')">
              エリアを選んで編集可
            </label>
            <div id="eu_editChecks" class="d-flex flex-wrap gap-2 ps-3 pt-1 ${editNone ? 'd-none' : ''}">
              ${editChecks || '<span class="text-muted small">エリアなし</span>'}
            </div>`
        }
      </div>
    </div>
  `;
  document.getElementById('editModalSaveBtn').onclick = () => {
    const newName  = document.getElementById('eu_name').value.trim();
    const newEmail = document.getElementById('eu_email').value.trim();
    if (!newName)  { showAlert('名前を入力してください'); return; }
    if (!newEmail) { showAlert('メールアドレスを入力してください'); return; }
    const adminChecked = document.getElementById('eu_isAdmin').checked;
    const viewMode = document.querySelector('input[name="eu_viewMode"]:checked').value;
    const newViewable = viewMode === 'all' ? '' : [...document.querySelectorAll('.eu_viewCb:checked')].map(cb => cb.value).join(',');
    // 管理者は editableAreas を空に（全エリア編集可）、それ以外はUIから取得
    let newEditable = '';
    if (!adminChecked) {
      const editModeEl = document.querySelector('input[name="eu_editMode"]:checked');
      const editMode = editModeEl ? editModeEl.value : 'none';
      newEditable = editMode === 'none' ? '' : [...document.querySelectorAll('.eu_editCb:checked')].map(cb => cb.value).join(',');
    }
    showLoading(true);
    google.script.run
      .withSuccessHandler(result => {
        showLoading(false);
        editModalBS.hide();
        if (result.status === 'success') reloadUsers();
        else showAlert('更新エラー: ' + result.message);
      })
      .withFailureHandler(handleError)
      .updateUser({
        id,
        name:          newName,
        email:         newEmail,
        isAdmin:       document.getElementById('eu_isAdmin').checked,
        viewableAreas: newViewable,
        editableAreas: newEditable
      });
  };
  editModalBS.show();
}

function deleteUserConfirm(id, name) {
  showConfirm(`ユーザー「${name}」を削除しますか？`, () => {
    showLoading(true);
    google.script.run
      .withSuccessHandler(result => {
        showLoading(false);
        if (result.status === 'success') reloadUsers();
        else showAlert('削除エラー: ' + result.message);
      })
      .withFailureHandler(handleError)
      .deleteUser(id);
  });
}

function reloadUsers() {
  google.script.run
    .withSuccessHandler(data => {
      users = data || [];
      renderUserSettings();
    })
    .withFailureHandler(handleError)
    .getUsers();
}
