    <div class="mb-2"><label class="form-label form-label-sm">会社名</label>
      <input type="text" id="editClientName" class="form-control form-control-sm" value="${escHtml(c.name)}"></div>
    <div class="mb-2"><label class="form-label form-label-sm">備考</label>
