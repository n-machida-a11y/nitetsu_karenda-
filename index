<!DOCTYPE html>
<html lang="ja">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <title>得意先お休み管理カレンダー</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
  <style>
    /* ===== リセット・ベース ===== */
    html, body { height: 100%; margin: 0; padding: 0; font-family: "Helvetica Neue", Arial, sans-serif; background: #f8f9fa; }
    body { display: flex; flex-direction: column; }

    /* ===== ヘッダー ===== */
    #appHeader {
      display: flex; align-items: center; gap: 10px;
      background: #1565c0; color: #fff;
      padding: 8px 16px; flex-shrink: 0; z-index: 200;
    }
    #appHeader h1 { font-size: 1rem; margin: 0; flex: 1; }
    #appHeader .header-right { display: flex; align-items: center; gap: 8px; }
    #appHeader button { background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.4); color: #fff; border-radius: 4px; padding: 4px 10px; font-size: 0.85rem; cursor: pointer; }
    #appHeader button:hover { background: rgba(255,255,255,0.3); }
    #settingsBtn { font-size: 1rem !important; padding: 6px 16px !important; font-weight: 600; }
    #userBadge { font-size: 0.82rem; background: rgba(255,255,255,0.2); padding: 3px 10px; border-radius: 12px; white-space: nowrap; }

    /* ===== メインレイアウト ===== */
    #mainLayout { display: flex; flex: 1; overflow: hidden; }

    /* ===== サイドバー ===== */
    #sidebar {
      width: 280px; flex-shrink: 0;
      background: #fff; border-right: 1px solid #dee2e6;
      overflow-y: auto; display: flex; flex-direction: column;
    }
    #sidebarHeader { padding: 10px 12px; border-bottom: 1px solid #dee2e6; background: #f1f3f4; }
    #sidebarHeader .sidebar-title { font-weight: 600; font-size: 0.85rem; color: #555; margin-bottom: 6px; }
    #clientList { flex: 1; padding: 4px 0; overflow-y: auto; }
    .client-item {
      display: flex; align-items: center; gap: 5px;
      padding: 6px 10px; cursor: default;
      border-left: 3px solid transparent;
      transition: background 0.15s;
    }
    .client-item:hover { background: #f0f4ff; }
    .client-item.input-active {
      background: #e3f2fd; border-left-color: #1565c0;
    }
    .client-item .filter-cb { cursor: pointer; flex-shrink: 0; }
    .client-color-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; border: 1px solid rgba(0,0,0,0.15); }
    .client-name-wrap { flex: 1; min-width: 0; padding: 0 4px; }
    .client-name-label { font-size: 0.92rem; color: #333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .client-item.input-active .client-name-label { font-weight: 700; color: #1565c0; }
    .client-rule-text { font-size: 0.68rem; color: #888; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 1px; }
    .rule-info-btn {
      flex-shrink: 0;
      background: #fff8e1; color: #f57f17;
      border: 1px solid #ffe082; border-radius: 4px;
      padding: 2px 5px; font-size: 0.75rem; cursor: pointer;
      line-height: 1;
    }
    .rule-info-btn:hover { background: #fff3cd; }
    .input-start-btn {
      flex-shrink: 0;
      background: #1565c0; color: #fff;
      border: none; border-radius: 4px;
      padding: 3px 7px; font-size: 0.72rem; cursor: pointer;
      white-space: nowrap;
    }
    .input-start-btn:hover { background: #0d47a1; }
    .client-item.input-active .input-start-btn { background: #e53935; }
    .client-item.input-active .input-start-btn::before { content: '■ '; }
    .rule-badge { font-size: 0.7rem; color: #856404; background: #fff3cd; border-radius: 10px; padding: 1px 5px; flex-shrink: 0; }
    #sidebarFooter { padding: 8px 12px; border-top: 1px solid #dee2e6; }
    #stopInputBtn {
      font-size: 0.72rem; padding: 2px 7px; border-radius: 4px;
      border: 1px solid #e53935; color: #e53935; background: #fff;
      cursor: pointer; white-space: nowrap;
    }
    #stopInputBtn:hover { background: #ffebee; }

    /* ===== カレンダーエリア ===== */
    #calendarArea { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }

    /* ===== 備考情報バー ===== */
    #clientInfoBar {
      background: #fff8e1; border-bottom: 1px solid #ffe082;
      padding: 7px 16px; flex-shrink: 0;
      display: flex; align-items: flex-start; gap: 10px;
    }
    #clientInfoBar.d-none { display: none !important; }
    #clientInfoBar .info-name { font-weight: 700; font-size: 0.88rem; flex-shrink: 0; color: #333; }
    #clientInfoBar .info-rule { font-size: 0.82rem; color: #555; flex: 1; white-space: pre-wrap; line-height: 1.5; }
    #clientInfoBar .info-close { flex-shrink: 0; background: none; border: none; cursor: pointer; color: #aaa; font-size: 1rem; padding: 0 2px; line-height: 1; }
    #clientInfoBar .info-close:hover { color: #c00; }

    /* ===== エリアタブ ===== */
    #areaTabBar {
      background: #fff; border-bottom: 1px solid #dee2e6;
      padding: 0 16px; flex-shrink: 0;
    }
    #areaTabList { margin: 0; gap: 2px; }
    #areaTabList .nav-link {
      color: #555; font-size: 0.88rem; padding: 7px 14px;
      border-radius: 6px 6px 0 0; border: 1px solid transparent;
    }
    #areaTabList .nav-link:hover { background: #f0f4ff; color: #1565c0; }
    #areaTabList .nav-link.active {
      color: #1565c0; font-weight: 700;
      border-color: #dee2e6 #dee2e6 #fff;
      background: #fff;
    }

    /* ===== 入力ツールバー ===== */
    #inputToolbar {
      background: #fff; border-bottom: 2px solid #1565c0;
      padding: 10px 16px; flex-shrink: 0;
    }
    #inputToolbar.d-none { display: none !important; }
    #inputModeHeader { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
    #inputModeLabel { font-weight: 700; font-size: 1rem; color: #1565c0; }
    #exitInputModeBtn {
      margin-left: auto; background: none; border: 1px solid #ccc;
      border-radius: 50%; width: 26px; height: 26px; cursor: pointer;
      font-size: 0.85rem; display: flex; align-items: center; justify-content: center;
      color: #666;
    }
    #exitInputModeBtn:hover { background: #fee; color: #c00; border-color: #c00; }
    #palette { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
    .palette-btn {
      display: flex; align-items: center; gap: 5px;
      border: 2px solid #ccc; border-radius: 20px;
      padding: 4px 12px; cursor: pointer; background: #fff;
      font-size: 0.85rem; transition: all 0.15s;
    }
    .palette-btn:hover { border-color: #888; }
    .palette-btn.active { border-color: #1565c0; background: #e3f2fd; font-weight: 600; }
    .palette-color-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    #bulkActions { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
    #bulkActions button {
      font-size: 0.8rem; padding: 3px 10px;
      border-radius: 4px; border: 1px solid #ccc;
      background: #fff; cursor: pointer;
    }
    #bulkActions button:hover { background: #f0f0f0; }

    /* ===== カレンダー本体 ===== */
    #calendarWrapper { flex: 1; overflow-y: auto; padding: 12px 16px 80px; }
    #calendar { background: #fff; border-radius: 8px; padding: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }

    /* ===== カレンダー内スタイル ===== */
    .fc-bg-event { pointer-events: none !important; }
    .fc-daygrid-day.holiday-cell { background: #fff0f0 !important; }
    .fc-daygrid-day.no-event-day { opacity: 0.45; cursor: not-allowed !important; }
    .fc-day-sat .fc-daygrid-day-number { color: #1565c0; }
    .fc-day-sun .fc-daygrid-day-number { color: #c62828; }
    .fc-day-sat { background: #f8fbff; }
    .fc-day-sun { background: #fff8f8; }

    /* ===== イベント表示 ===== */
    .ev-wrap {
      padding: 1px 4px;
      font-size: 0.8rem;
      line-height: 1.3;
      overflow: hidden;
    }
    .ev-time {
      font-size: 0.7em;
      opacity: 0.82;
      line-height: 1.1;
      letter-spacing: 0.01em;
    }
    .ev-dot {
      display: inline-block;
      width: 7px; height: 7px;
      border-radius: 50%;
      margin-right: 3px;
      vertical-align: middle;
    }
    .fc-daygrid-event:has(.ev-time) { height: auto !important; }
    .fc-daygrid-event .fc-event-main { overflow: visible; }
    .fc-daygrid-event { white-space: normal !important; }

    /* 選択済み日付 */
    .fc-daygrid-day.selected-cell { background: rgba(21,101,192,0.15) !important; }
    .fc-daygrid-day.selected-cell .fc-daygrid-day-number { font-weight: 700; color: #1565c0; }

    /* ドラッグ中ハイライト */
    .fc-daygrid-day.drag-highlight { background: rgba(21,101,192,0.25) !important; outline: 2px dashed #1565c0; }

    /* 他社フェード */
    .event-faded { opacity: 0.18 !important; pointer-events: none !important; }

    /* プレビューイベント */
    .fc-event.preview-event { opacity: 0.5 !important; border-style: dashed !important; }

    /* 入力モード中のカーソル */
    .input-mode-cursor .fc-daygrid-day-bg,
    .input-mode-cursor .fc-daygrid-day-frame { cursor: pointer !important; }

    /* ===== スティッキーフッター ===== */
    #stickyFooter {
      position: fixed; bottom: 0; left: 0; right: 0;
      background: #1565c0; color: #fff;
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 20px; z-index: 300;
      box-shadow: 0 -2px 8px rgba(0,0,0,0.2);
    }
    #stickyFooter.d-none { display: none !important; }
    #selectedCount { font-size: 0.95rem; }
    #bulkRegisterBtn {
      background: #fff; color: #1565c0; border: none;
      border-radius: 6px; padding: 6px 20px;
      font-weight: 700; font-size: 0.95rem; cursor: pointer;
    }
    #bulkRegisterBtn:hover { background: #e3f2fd; }

    /* ===== ローディング ===== */
    #loadingOverlay {
      position: fixed; inset: 0; background: rgba(255,255,255,0.7);
      display: flex; align-items: center; justify-content: center;
      z-index: 9999;
    }
    #loadingOverlay.d-none { display: none !important; }

    /* ===== 設定モーダル ===== */
    .settings-item {
      display: flex; align-items: center; gap: 8px;
      padding: 8px 12px; border-bottom: 1px solid #f0f0f0;
    }
    .settings-item:last-child { border-bottom: none; }
    .settings-item .item-name { flex: 1; font-size: 0.9rem; }
    .settings-item .item-meta { font-size: 0.78rem; color: #888; }
    .color-preview { width: 16px; height: 16px; border-radius: 3px; flex-shrink: 0; border: 1px solid rgba(0,0,0,0.1); }

    /* ===== 権限バッジ（ユーザー管理） ===== */
    .role-label { font-size: 0.75rem; padding: 2px 7px; border-radius: 10px; font-weight: 600; }
    .role-label.admin  { background: #fff9c4; color: #5d4037; border: 1px solid #fdd835; }
    .role-label.area   { background: #e8f5e9; color: #2e7d32; border: 1px solid #66bb6a; }
    .role-label.viewer { background: #eceff1; color: #546e7a; border: 1px solid #b0bec5; }

    /* 設定モーダルの上に必ず重なるよう z-index を高く設定 */
    #editModal, #customAlertModal, #customConfirmModal { z-index: 1090 !important; }

    /* ===== モバイル ===== */
    @media (max-width: 767px) {
      #sidebar { display: none; }
      #menuToggleBtn { display: inline-block !important; }
      #calendarWrapper { padding: 8px 8px 80px; }
      #calendar { padding: 8px; }
      #inputToolbar { padding: 8px 10px; }
      #palette { gap: 4px; }
      .palette-btn { padding: 3px 8px; font-size: 0.78rem; }
    }
    @media (min-width: 768px) {
      #menuToggleBtn { display: none !important; }
    }
  </style>
</head>
<body>

<!-- ===== ヘッダー ===== -->
<header id="appHeader">
  <button id="menuToggleBtn" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas" style="display:none">☰</button>
  <h1>得意先お休み管理カレンダー</h1>
  <div class="header-right">
    <span id="userBadge" style="display:none"></span>
    <button id="settingsBtn" style="display:none">⚙ 設定</button>
  </div>
</header>

<!-- ===== メインレイアウト ===== -->
<div id="mainLayout">

  <!-- サイドバー（デスクトップ） -->
  <aside id="sidebar">
    <div id="sidebarHeader">
      <div class="sidebar-title">得意先</div>
      <div class="d-flex align-items-center gap-2">
        <label class="d-flex align-items-center gap-1" style="font-size:0.82rem; cursor:pointer; margin:0;">
          <input type="checkbox" id="filterAll" checked> 全表示
        </label>
        <button id="stopInputBtn" class="d-none" onclick="exitInputMode()">⏹ 入力中止</button>
      </div>
    </div>
    <div id="clientList">
      <div class="text-muted small p-3">読み込み中...</div>
    </div>
    <div id="sidebarFooter">
      <small class="text-muted">▶入力 を押すと予定を登録できます</small>
    </div>
  </aside>

  <!-- カレンダーエリア -->
  <div id="calendarArea">

    <!-- 備考情報バー -->
    <div id="clientInfoBar" class="d-none">
      <span class="info-name" id="infoBarName"></span>
      <span class="info-rule" id="infoBarRule"></span>
      <button class="info-close" onclick="hideInfoBar()" title="閉じる">✕</button>
    </div>

    <!-- エリアタブ -->
    <div id="areaTabBar">
      <ul class="nav nav-tabs" id="areaTabList">
        <!-- JS で動的生成 -->
      </ul>
    </div>

    <!-- 入力ツールバー -->
    <div id="inputToolbar" class="d-none">
      <div id="inputModeHeader">
        <span id="inputModeLabel"></span>
        <button id="exitInputModeBtn" title="入力モードを終了">✕</button>
      </div>
      <div id="palette"><!-- JS で動的生成 --></div>
      <div id="bulkActions">
        <button id="selectWeekendsBtn">🗓 土日を全選択</button>
        <button id="selectHolidaysBtn">🎌 祝日を選択</button>
        <button id="clearSelBtn">✕ 選択クリア</button>
      </div>
    </div>

    <!-- カレンダー本体 -->
    <div id="calendarWrapper">
      <div id="calendar"></div>
    </div>
  </div>
</div>

<!-- スティッキーフッター -->
<div id="stickyFooter" class="d-none">
  <span id="selectedCount">0日選択中</span>
  <button id="bulkRegisterBtn">一括登録</button>
</div>

<!-- ローディング -->
<div id="loadingOverlay">
  <div class="spinner-border text-primary" role="status"></div>
</div>

<!-- カスタムアラートモーダル -->
<div class="modal fade" id="customAlertModal" tabindex="-1" style="z-index:1090">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body py-3 px-4">
        <p id="customAlertMsg" style="white-space:pre-line;margin:0;font-size:0.95rem;"></p>
      </div>
      <div class="modal-footer py-2 justify-content-center border-0">
        <button class="btn btn-primary" id="customAlertOk" style="min-width:80px">OK</button>
      </div>
    </div>
  </div>
</div>

<!-- カスタム確認モーダル -->
<div class="modal fade" id="customConfirmModal" tabindex="-1" style="z-index:1090">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body py-3 px-4">
        <p id="customConfirmMsg" style="white-space:pre-line;margin:0;font-size:0.95rem;"></p>
      </div>
      <div class="modal-footer py-2 justify-content-between border-0">
        <button class="btn btn-secondary" id="customConfirmNo" style="min-width:80px">キャンセル</button>
        <button class="btn btn-primary"   id="customConfirmYes" style="min-width:80px">はい</button>
      </div>
    </div>
  </div>
</div>

<!-- ===== モバイル用オフキャンバス サイドバー ===== -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas" style="width:300px">
  <div class="offcanvas-header" style="background:#1565c0; color:#fff; padding:8px 16px;">
    <h6 class="offcanvas-title mb-0">得意先</h6>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
  </div>
  <div class="offcanvas-body p-0">
    <div id="sidebarOffcanvasHeader" style="padding:8px 12px; border-bottom:1px solid #dee2e6; background:#f1f3f4;">
      <div class="d-flex align-items-center gap-2">
        <label class="d-flex align-items-center gap-1" style="font-size:0.82rem; cursor:pointer; margin:0;">
          <input type="checkbox" id="filterAllMobile" checked> 全表示
        </label>
        <button id="stopInputBtnMobile" class="d-none" style="font-size:0.72rem;padding:2px 7px;border-radius:4px;border:1px solid #e53935;color:#e53935;background:#fff;cursor:pointer;" onclick="exitInputMode()">⏹ 入力中止</button>
      </div>
    </div>
    <div id="clientListMobile"></div>
  </div>
</div>

<!-- ===== 設定モーダル ===== -->
<div class="modal fade" id="settingsModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">設定</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <ul class="nav nav-tabs mb-3" id="settingsTabs">
          <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#companyTab">会社管理</button></li>
          <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#patternTab">パターン管理</button></li>
          <li class="nav-item" id="userTabItem" style="display:none"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#userTab">ユーザー管理</button></li>
          <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#areaTab">エリア管理</button></li>
        </ul>

        <div class="tab-content">
          <!-- 会社管理タブ -->
          <div class="tab-pane fade show active" id="companyTab">
            <div class="d-flex flex-wrap gap-2 mb-3 align-items-end">
              <div>
                <label class="form-label form-label-sm mb-1">会社名</label>
                <input type="text" id="newClientName" class="form-control form-control-sm" placeholder="会社名" style="max-width:160px">
              </div>
              <div>
                <label class="form-label form-label-sm mb-1">備考</label>
                <input type="text" id="newClientMemo" class="form-control form-control-sm" placeholder="備考（任意）" style="max-width:160px">
              </div>
              <div>
                <label class="form-label form-label-sm mb-1">エリア</label>
                <select id="newClientArea" class="form-select form-select-sm" style="max-width:140px">
                  <option value="">未設定</option>
                </select>
              </div>
              <div>
                <label class="form-label form-label-sm mb-1">色</label>
                <input type="color" id="newClientColor" class="form-control form-control-sm form-control-color" value="#1565c0" style="width:50px">
              </div>
              <button class="btn btn-sm btn-primary" id="addClientBtn">追加</button>
            </div>
            <div id="clientSettingsList" style="max-height:360px; overflow-y:auto; border:1px solid #dee2e6; border-radius:4px;">
              <div class="text-muted small p-3">読み込み中...</div>
            </div>
          </div>

          <!-- エリア管理タブ -->
          <div class="tab-pane fade" id="areaTab">
            <div class="d-flex gap-2 mb-3">
              <input type="text" id="newAreaName" class="form-control form-control-sm" placeholder="エリア名（例: 関西）" style="max-width:200px">
              <button class="btn btn-sm btn-primary" id="addAreaBtn">追加</button>
            </div>
            <div id="areaSettingsList" style="max-height:360px; overflow-y:auto; border:1px solid #dee2e6; border-radius:4px;">
              <div class="text-muted small p-3">読み込み中...</div>
            </div>
          </div>

          <!-- パターン管理タブ -->
          <div class="tab-pane fade" id="patternTab">
            <div class="d-flex flex-wrap gap-2 mb-3 align-items-end">
              <div>
                <label class="form-label form-label-sm mb-1">パターン名</label>
                <input type="text" id="newPatternName" class="form-control form-control-sm" placeholder="例: 午後不可" style="max-width:140px">
              </div>
              <div>
                <label class="form-label form-label-sm mb-1">開始時刻</label>
                <select id="newPatternStart" class="form-select form-select-sm" style="max-width:120px">
                  <option value="allday">終日（休み）</option>
                  <option value="08:00">08:00</option>
                  <option value="09:00">09:00</option>
                  <option value="10:00">10:00</option>
                  <option value="11:00">11:00</option>
                  <option value="12:00">12:00</option>
                  <option value="13:00">13:00</option>
                  <option value="14:00">14:00</option>
                  <option value="15:00">15:00</option>
                  <option value="16:00">16:00</option>
                  <option value="17:00">17:00</option>
                </select>
              </div>
              <div id="patternEndWrapper">
                <label class="form-label form-label-sm mb-1">終了時刻</label>
                <select id="newPatternEnd" class="form-select form-select-sm" style="max-width:120px">
                  <option value="10:00">10:00</option>
                  <option value="11:00">11:00</option>
                  <option value="12:00">12:00</option>
                  <option value="13:00">13:00</option>
                  <option value="14:00">14:00</option>
                  <option value="15:00" selected>15:00</option>
                  <option value="16:00">16:00</option>
                  <option value="17:00">17:00</option>
