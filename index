function renderClientSettings() {
  const container = document.getElementById('clientSettingsList');
  let visibleForSettings = clients;
  if (!isAdmin() && currentUser) {
    const editList = parseIdList(currentUser.editableAreas);
    if (editList.length > 0) {
      visibleForSettings = clients.filter(c => editList.includes(c.areaId));
    }
  }

  if (visibleForSettings.length === 0) {
    container.innerHTML = '<div class="text-muted small p-3">会社がありません</div>';
    return;
  }

  // エリアでグループ化
  const grouped = {};
  visibleForSettings.forEach(c => {
    const key = c.areaId || '__none__';
    if (!grouped[key]) grouped[key] = [];
    grouped[key].push(c);
  });

  // エリアの表示順（areas の順 + 未設定を最後）
  const areaOrder = areas.map(a => a.id);
  const sortedKeys = Object.keys(grouped).sort((a, b) => {
    const ai = a === '__none__' ? 9999 : areaOrder.indexOf(a);
    const bi = b === '__none__' ? 9999 : areaOrder.indexOf(b);
    return (ai === -1 ? 9998 : ai) - (bi === -1 ? 9998 : bi);
  });

  let html = '<div class="accordion" id="clientAccordion">';
  sortedKeys.forEach((key, idx) => {
    const area = areas.find(a => a.id === key);
    const areaName = area ? escHtml(area.name) : '未設定';
    const collapseId = 'clientArea_' + (key === '__none__' ? 'none' : key.replace(/[^a-zA-Z0-9]/g, '_'));
    const isOpen = idx === 0;

    html += `
      <div class="accordion-item">
        <h6 class="accordion-header m-0">
          <button class="accordion-button ${isOpen ? '' : 'collapsed'}" type="button"
            data-bs-toggle="collapse" data-bs-target="#${collapseId}">
            ${areaName}
            <span class="badge bg-secondary ms-2" style="font-size:0.7rem;">${grouped[key].length}</span>
          </button>
        </h6>
        <div id="${collapseId}" class="accordion-collapse collapse ${isOpen ? 'show' : ''}">
          <div class="accordion-body p-0">
            <div class="sortable-list" data-area-id="${escHtml(key)}">
    `;

    grouped[key].forEach(c => {
      const clientColor = (c.color && c.color !== '') ? c.color : '#6c757d';
      html += `
        <div class="settings-item sortable-item" draggable="true" data-id="${escHtml(c.id)}"
          ondragstart="onClientDragStart(event)" ondragover="onClientDragOver(event)"
          ondragleave="onClientDragLeave(event)" ondrop="onClientDrop(event)" ondragend="onClientDragEnd(event)">
          <span class="drag-handle">⠿</span>
          <div class="color-preview" style="background:${escHtml(clientColor)}"></div>
          <div class="item-name">${escHtml(c.name)}</div>
          <button class="btn btn-xs btn-outline-secondary btn-sm ms-auto" style="padding:2px 8px;font-size:0.75rem"
            onclick="editClientModal('${escHtml(c.id)}')">編集</button>
          <button class="btn btn-xs btn-outline-danger btn-sm ms-1" style="padding:2px 8px;font-size:0.75rem"
            onclick="deleteClientConfirm('${escHtml(c.id)}','${escHtml(c.name)}')">削除</button>
        </div>
      `;
    });

    html += `
            </div>
          </div>
        </div>
      </div>
    `;
  });

  html += '</div>';
  container.innerHTML = html;
}

