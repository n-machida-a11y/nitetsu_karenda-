<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
// =====================================================================
// 状態変数
// =====================================================================
let calendar;
let rawEvents      = [];           // GASから取得した全イベント
let holidayDates   = new Set();    // 祝日日付 Set<'YYYY-MM-DD'>
let clients        = [];           // 会社マスター [{id,name,memo,areaId,color}]
let areas          = [];           // エリアマスター [{id,name}]
let users          = [];           // ユーザーマスター [{id,name,email,areaId,role}]
let currentUser    = null;         // 現在のユーザー情報
let activeAreaId   = '__all__';    // 選択中のエリアID（'__all__' = 全て）
let clientRules    = {};           // {name: ルール文字列}
let patterns       = [];           // 入力パターン [{id,name,startTime,endTime,color,order}]
let checkedClients = new Set();    // 表示フィルターでチェック済みの会社名
let inputModeClient = null;            // 入力モード中の会社名（null=通常モード）
let selectionsByPattern = new Map();   // Map<patternId, Set<dateStr>>
let preInputFilters = null;            // 入力モード前のフィルター状態

// ドラッグ選択用
let isDragging    = false;
let wasDragging   = false;
let pointerDownDate = null;
let draggedDates  = new Set();

// Bootstrap モーダルインスタンス
let settingsModal, editModalBS, customAlertModal, customConfirmModal;

// =====================================================================
// ユーティリティ
// =====================================================================
function showLoading(v) { document.getElementById('loadingOverlay').classList.toggle('d-none', !v); }

function escHtml(str) {
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function toDateStr(date) {
  const off = date.getTimezoneOffset() * 60000;
  return new Date(date.getTime() - off).toISOString().split('T')[0];
}

// =====================================================================
// 権限チェック
// =====================================================================
function isAdmin() { return !!(currentUser && currentUser.isAdmin); }

/** カンマ区切り文字列をIDの配列に変換（空文字は空配列） */
function parseIdList(str) {
  if (!str) return [];
  return str.split(',').map(s => s.trim()).filter(Boolean);
}

/** 指定会社への入力権限 */
function canEdit(clientName) {
  if (!currentUser) return false;
  if (currentUser.isAdmin) return true; // 管理者は全エリア編集可
  const editList = parseIdList(currentUser.editableAreas);
  if (editList.length === 0) return false;
  const client = clients.find(c => c.name === clientName);
  if (!client || !client.areaId) return false;
  return editList.includes(client.areaId);
}

/** 設定モーダルを開く権限（管理者 or 編集エリアが1つ以上設定されているユーザー） */
function canOpenSettings() {
  if (!currentUser) return false;
  if (currentUser.isAdmin) return true;
  return parseIdList(currentUser.editableAreas).length > 0;
}

// =====================================================================
// selectionsByPattern ヘルパー
// =====================================================================
function getAllSelectedDates() {
  const all = new Set();
  selectionsByPattern.forEach(set => set.forEach(d => all.add(d)));
  return all;
}

function getTotalSelectedCount() {
  let n = 0;
  selectionsByPattern.forEach(set => { n += set.size; });
  return n;
}

function addToSelection(patId, dateStr) {
  selectionsByPattern.forEach((set, pid) => { if (pid !== patId) set.delete(dateStr); });
  if (!selectionsByPattern.has(patId)) selectionsByPattern.set(patId, new Set());
  selectionsByPattern.get(patId).add(dateStr);
}

function removeFromAllPatterns(dateStr) {
  selectionsByPattern.forEach(set => set.delete(dateStr));
}

function toDateStrFromAny(v) {
  if (!v) return '';
  return String(v).substring(0, 10);
}

function formatDateDisplay(dateStr) {
  const d = new Date(dateStr + 'T00:00:00');
  const days = ['日','月','火','水','木','金','土'];
  return `${d.getMonth()+1}/${d.getDate()}(${days[d.getDay()]})`;
}

// =====================================================================
// 初期化
// =====================================================================
document.addEventListener('DOMContentLoaded', () => {
  settingsModal      = new bootstrap.Modal(document.getElementById('settingsModal'));
  editModalBS        = new bootstrap.Modal(document.getElementById('editModal'));
  customAlertModal   = new bootstrap.Modal(document.getElementById('customAlertModal'));
  customConfirmModal = new bootstrap.Modal(document.getElementById('customConfirmModal'));

  // 設定モーダルの上に重なるモーダルのバックドロップを前面に出す
  ['editModal','customAlertModal','customConfirmModal'].forEach(id => {
    document.getElementById(id).addEventListener('show.bs.modal', () => {
      setTimeout(() => {
        const bds = document.querySelectorAll('.modal-backdrop');
        if (bds.length > 0) bds[bds.length - 1].style.zIndex = '1089';
      }, 0);
    });
  });

  initCalendar();

  document.getElementById('settingsBtn').addEventListener('click', openSettings);
  document.getElementById('exitInputModeBtn').addEventListener('click', exitInputMode);
  document.getElementById('bulkRegisterBtn').addEventListener('click', bulkRegister);

  document.getElementById('selectWeekendsBtn').addEventListener('click', selectAllWeekends);
  document.getElementById('selectHolidaysBtn').addEventListener('click', selectHolidays);
  document.getElementById('clearSelBtn').addEventListener('click', clearSelection);

  document.getElementById('filterAll').addEventListener('change', e => {
    const checked = e.target.checked;
    // 現在のエリアタブに対応した会社のみ対象
    getVisibleClients().forEach(c => {
      if (checked) checkedClients.add(c.name);
      else         checkedClients.delete(c.name);
    });
    document.getElementById('filterAllMobile').checked = checked;
    renderSidebar();
    calendar.refetchEvents();
  });
  document.getElementById('filterAllMobile').addEventListener('change', e => {
    document.getElementById('filterAll').checked = e.target.checked;
    document.getElementById('filterAll').dispatchEvent(new Event('change'));
  });

  document.getElementById('newPatternStart').addEventListener('change', function() {
    document.getElementById('patternEndWrapper').style.display = this.value === 'allday' ? 'none' : '';
  });

  document.getElementById('settingsModal').addEventListener('shown.bs.modal', () => {
    refreshSettingsAreaSelects();
    renderClientSettings();
    renderAreaSettings();
    renderPatternSettings();
    if (currentUser && currentUser.isAdmin) {
      // ユーザー一覧をGASから最新取得して表示
      google.script.run
        .withSuccessHandler(data => { users = data || []; renderUserSettings(); })
        .withFailureHandler(handleError)
        .getUsers();
    }
  });

  document.getElementById('addClientBtn').addEventListener('click', handleAddClient);
  document.getElementById('addAreaBtn').addEventListener('click', handleAddArea);
  document.getElementById('addPatternBtn').addEventListener('click', handleAddPattern);
  document.getElementById('addUserBtn').addEventListener('click', handleAddUser);

  document.getElementById('palette').addEventListener('change', () => {
    if (rawEvents.length > 0) calendar.refetchEvents();
  });

  loadAllData();
});

// =====================================================================
// データ取得（チェーン）
// =====================================================================
function loadAllData() {
  showLoading(true);
  // まず現在のユーザー情報を取得
  google.script.run
    .withSuccessHandler(userInfo => {
      currentUser = userInfo;
      applyUserUI();
      // 次にエリアを取得
      google.script.run
        .withSuccessHandler(areaData => {
          areas = areaData || [];
          renderAreaTabs();
          // 次にクライアントを取得
          google.script.run
            .withSuccessHandler(clientData => {
              clients = clientData || [];
              checkedClients = new Set(clients.map(c => c.name));
              google.script.run
                .withSuccessHandler(data => {
                  patterns = data || [];
                  if (patterns.length === 0) {
                    google.script.run
                      .withSuccessHandler(result => {
                        patterns = (result && result.patterns) || [];
                        continueLoading();
                      })
                      .withFailureHandler(handleError)
                      .initDefaultPatterns();
                  } else {
                    continueLoading();
                  }
                })
                .withFailureHandler(handleError)
                .getPatterns();
            })
            .withFailureHandler(handleError)
            .getClients();
        })
        .withFailureHandler(handleError)
        .getAreas();
    })
    .withFailureHandler(err => {
      // ユーザー情報取得失敗はviewerとして続行
      currentUser = { id: '', name: '', email: '', areaId: '', role: 'viewer' };
      applyUserUI();
      google.script.run
        .withSuccessHandler(areaData => {
          areas = areaData || [];
          renderAreaTabs();
          google.script.run
            .withSuccessHandler(clientData => {
              clients = clientData || [];
              checkedClients = new Set(clients.map(c => c.name));
              google.script.run
                .withSuccessHandler(data => {
                  patterns = data || [];
                  continueLoading();
                })
                .withFailureHandler(handleError)
                .getPatterns();
            })
            .withFailureHandler(handleError)
            .getClients();
        })
        .withFailureHandler(handleError)
        .getAreas();
    })
    .getCurrentUserInfo();
}

function continueLoading() {
  clientRules = {};
  clients.forEach(c => { if (c.memo && c.memo.trim()) clientRules[c.name] = c.memo.trim(); });

  google.script.run
    .withSuccessHandler(data => {
      rawEvents = data || [];
      extractHolidays(rawEvents);
      buildPalette();
      renderSidebar();
      calendar.refetchEvents();
      showLoading(false);
    })
    .withFailureHandler(handleError)
    .getHolidays();
}

/** ユーザー情報に応じてUIを切り替え */
function applyUserUI() {
  if (!currentUser) return;
  // ユーザー名のみ表示（管理者の場合は括弧付き）
  const badge = document.getElementById('userBadge');
  const displayName = currentUser.name || currentUser.email;
  if (displayName) {
    badge.textContent = currentUser.isAdmin ? displayName + '（管理者）' : displayName;
    badge.style.display = '';
  }
  // 設定ボタン（管理者 or 編集エリアが設定されているユーザー）
  document.getElementById('settingsBtn').style.display = canOpenSettings() ? '' : 'none';
  // ユーザー管理タブ（管理者のみ）
  document.getElementById('userTabItem').style.display = currentUser.isAdmin ? '' : 'none';
}

// =====================================================================
// 備考情報バー
// =====================================================================
function showInfoBar(clientName) {
  const rule = clientRules[clientName];
  if (!rule) { hideInfoBar(); return; }
  document.getElementById('infoBarName').textContent = clientName + '：';
  document.getElementById('infoBarRule').textContent = rule;
  document.getElementById('clientInfoBar').classList.remove('d-none');
}

function hideInfoBar() {
  document.getElementById('clientInfoBar').classList.add('d-none');
}

function showAlert(msg, onOk) {
  document.getElementById('customAlertMsg').textContent = msg;
  document.getElementById('customAlertOk').onclick = () => {
    customAlertModal.hide();
    if (onOk) onOk();
  };
  customAlertModal.show();
}
function showConfirm(msg, onYes) {
  document.getElementById('customConfirmMsg').textContent = msg;
  document.getElementById('customConfirmYes').onclick = () => { customConfirmModal.hide(); onYes(); };
  document.getElementById('customConfirmNo').onclick  = () => customConfirmModal.hide();
  customConfirmModal.show();
}

function handleError(err) {
  showLoading(false);
  console.error('GASエラー:', err);
  showAlert('エラーが発生しました: ' + (err.message || JSON.stringify(err)));
}

function reloadEvents() {
  showLoading(true);
  google.script.run
    .withSuccessHandler(data => {
      rawEvents = data || [];
      extractHolidays(rawEvents);
      calendar.refetchEvents();
      showLoading(false);
    })
    .withFailureHandler(handleError)
    .getHolidays();
}

function extractHolidays(events) {
  holidayDates.clear();
  events.forEach(e => {
    if (e.extendedProps && e.extendedProps.isHoliday) {
      holidayDates.add(toDateStrFromAny(e.start));
    }
  });
}

// =====================================================================
// エリアタブ
// =====================================================================
/** 現在のユーザーが閲覧できるエリア一覧 */
function getViewableAreas() {
  if (!currentUser || currentUser.role === 'admin') return areas;
  const viewList = parseIdList(currentUser.viewableAreas);
  if (viewList.length === 0) return areas; // 空 = 全エリア表示
  return areas.filter(a => viewList.includes(a.id));
}

function renderAreaTabs() {
  const tabList = document.getElementById('areaTabList');
  tabList.innerHTML = '';

  const viewable = getViewableAreas();
  // 「全て」タブ: viewableAreas が空（全エリア表示可）のときのみ表示
  const viewList = parseIdList(currentUser ? currentUser.viewableAreas : '');
  const showAll = !currentUser || currentUser.role === 'admin' || viewList.length === 0;

  if (showAll) {
    const allLi = document.createElement('li');
    allLi.className = 'nav-item';
    const allBtn = document.createElement('button');
    allBtn.className = 'nav-link' + (activeAreaId === '__all__' ? ' active' : '');
    allBtn.textContent = '全て';
    allBtn.addEventListener('click', () => selectArea('__all__'));
    allLi.appendChild(allBtn);
    tabList.appendChild(allLi);
  }

  viewable.forEach(area => {
    const li = document.createElement('li');
    li.className = 'nav-item';
    const btn = document.createElement('button');
    btn.className = 'nav-link' + (activeAreaId === area.id ? ' active' : '');
    btn.textContent = area.name;
    btn.addEventListener('click', () => selectArea(area.id));
    li.appendChild(btn);
    tabList.appendChild(li);
  });

  // アクティブタブが表示できないエリアになっていたら修正
  if (activeAreaId === '__all__' && !showAll) {
    activeAreaId = currentUser.areaId || (viewable[0] ? viewable[0].id : '__all__');
    // タブを再描画
    tabList.querySelectorAll('.nav-link').forEach(btn => {
      btn.classList.toggle('active', btn.textContent === (areas.find(a => a.id === activeAreaId) || {}).name);
    });
  }
}

function selectArea(areaId) {
  if (inputModeClient) {
    showConfirm('入力モード中です。エリアを切り替えると入力が中止されます。よろしいですか？', () => {
      exitInputMode();
      _doSelectArea(areaId);
    });
    return;
  }
  _doSelectArea(areaId);
}

function _doSelectArea(areaId) {
  activeAreaId = areaId;
  // タブ切り替え時はそのエリアの会社のみチェックONにリセット
  checkedClients = new Set(getVisibleClients().map(c => c.name));
  renderAreaTabs();
  renderSidebar();
  calendar.refetchEvents();
}

/** 現在のユーザーが閲覧できる会社一覧（エリア制限 + タブ絞り込み） */
function getVisibleClients() {
  let base = clients;
  // viewableAreas が設定されていれば表示エリアを絞り込む
  if (currentUser && currentUser.role !== 'admin') {
    const viewList = parseIdList(currentUser.viewableAreas);
    if (viewList.length > 0) {
      base = clients.filter(c => viewList.includes(c.areaId));
    }
  }
  if (activeAreaId === '__all__') return base;
  return base.filter(c => c.areaId === activeAreaId);
}

// =====================================================================
// FullCalendar 初期化
// =====================================================================
function initCalendar() {
  const calEl = document.getElementById('calendar');

  calendar = new FullCalendar.Calendar(calEl, {
    initialView: 'dayGridMonth',
    locale: 'ja',
    buttonText: { today: '今日', month: '月', week: '週', list: 'リスト' },
    headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,listWeek' },
    height: 'auto',
    selectable: false,
    editable: false,
    displayEventTime: false,
    eventDisplay: 'block',  // 時刻付きイベントもバー表示にして得意先カラーを適用

    dayCellContent: e => e.dayNumberText.replace('日', ''),

    dayCellClassNames: arg => {
      const dateStr = toDateStr(arg.date);
      const cls = [];
      if (holidayDates.has(dateStr)) cls.push('holiday-cell');
      if (inputModeClient) cls.push('input-mode-cursor');
      if (inputModeClient && getAllSelectedDates().has(dateStr)) cls.push('selected-cell');
      if (draggedDates.has(dateStr)) cls.push('drag-highlight');
      if (inputModeClient && getSelectedPatternId() === '__delete__') {
        const hasEvent = rawEvents.some(ev => {
          const p = ev.extendedProps || {};
          return !p.isHoliday && p.clientName === inputModeClient && toDateStrFromAny(ev.start) === dateStr;
        });
        if (!hasEvent) cls.push('no-event-day');
      }
      return cls;
    },

    events: (fetchInfo, successCallback) => {
      successCallback([...getFilteredEvents(), ...buildPreviewEvents()]);
    },

    eventContent: arg => {
      const props = arg.event.extendedProps || {};
      if (props.isHoliday) {
        return { html: `<div class="ev-wrap text-danger" style="pointer-events:none">${escHtml(arg.event.title)}</div>` };
      }

      const fmtTime = d => `${d.getHours().toString().padStart(2,'0')}:${d.getMinutes().toString().padStart(2,'0')}`;
      let timeRow = '';
      if (!arg.event.allDay && arg.event.start && arg.event.end) {
        timeRow = `<div class="ev-time">${fmtTime(arg.event.start)}〜${fmtTime(arg.event.end)}</div>`;
      }

      if (props.isPreview) {
        const client = clients.find(c => c.name === inputModeClient) || {};
        const clientColor = (client.color && client.color !== '') ? client.color : '#1565c0';
        return { html: `<div class="ev-wrap">▸${escHtml(arg.event.title)}${timeRow}</div>` };
      }

      // 通常イベント: 会社名（色はイベントのbackgroundColor=会社色）+ パターン名テキスト
      const patternName = escHtml(arg.event.title);
      return { html: `<div class="ev-wrap"><strong>${escHtml(props.clientName || '未設定')}</strong>: ${patternName}${timeRow}</div>` };
    },

    eventClassNames: arg => {
      const props = arg.event.extendedProps || {};
      if (props.isHoliday || props.isPreview) return [];
      if (inputModeClient && props.clientName !== inputModeClient) return ['event-faded'];
      return [];
    },

    dateClick: info => {
      if (!inputModeClient) return;
      if (wasDragging) { wasDragging = false; return; }
      toggleDateSelection(info.dateStr);
    },

    eventClick: info => {
      const props = info.event.extendedProps || {};
      if (props.isHoliday) return;

      if (!inputModeClient) {
        // 通常モード: イベントクリックで備考をカレンダー上部に表示
        if (props.clientName) showInfoBar(props.clientName);
        return;
      }
      // 入力モード: 日付選択として扱う
      info.jsEvent.preventDefault();
      info.jsEvent.stopPropagation();
      const dateStr = info.event.startStr.substring(0, 10);
      if (wasDragging) { wasDragging = false; return; }
      toggleDateSelection(dateStr);
    },

    eventsSet: () => { setTimeout(updateSelectedCells, 0); }
  });

  calendar.render();
  setupDragSelection(calEl);
}

// =====================================================================
// イベントフィルタリング
// =====================================================================
function getFilteredEvents() {
  // 入力モード・通常モード共通: checkedClients でフィルタリング
  // （入力モード中もエリア外のイベントは表示しない）
  return rawEvents.filter(ev => {
    if (ev.extendedProps && ev.extendedProps.isHoliday) return true;
    return checkedClients.has((ev.extendedProps || {}).clientName || '');
  });
}

// =====================================================================
// プレビューイベント生成
// =====================================================================
function buildPreviewEvents() {
  if (!inputModeClient || getTotalSelectedCount() === 0) return [];
  const previews = [];

  // 入力中の会社の色を使用
  const clientObj = clients.find(c => c.name === inputModeClient) || {};
  const clientColor = (clientObj.color && clientObj.color !== '') ? clientObj.color : '#1565c0';

  selectionsByPattern.forEach((dateSet, patId) => {
    if (patId === '__delete__' || dateSet.size === 0) return;
    const pattern = patterns.find(p => p.id === patId);
    if (!pattern) return;

    dateSet.forEach(dateStr => {
      let start, end;
      if (pattern.startTime === 'allday') {
        start = dateStr;
        const [y, m, day] = dateStr.split('-').map(Number);
        const next = new Date(y, m - 1, day + 1);
        end = localDateStr(next.getFullYear(), next.getMonth(), next.getDate());
      } else {
        start = dateStr + 'T' + pattern.startTime + ':00';
        end   = dateStr + 'T' + (pattern.endTime || '18:00') + ':00';
      }
      previews.push({
        id:              'preview_' + patId + '_' + dateStr,
        title:           pattern.name,
        start, end,
        backgroundColor: clientColor,
        borderColor:     clientColor,
        classNames:      ['preview-event'],
        extendedProps:   { isPreview: true, patternId: patId, clientName: inputModeClient }
      });
    });
  });
  return previews;
}

function getSelectedPatternId() {
  const el = document.querySelector('input[name="palette"]:checked');
  return el ? el.value : null;
}

// =====================================================================
// パレット（動的生成）
// =====================================================================
function buildPalette() {
  const container = document.getElementById('palette');
  container.innerHTML = '';

  // 入力中の得意先カラーを取得してドットに使用
  function getPaletteClientColor() {
    if (!inputModeClient) return '#6c757d';
    const c = clients.find(x => x.name === inputModeClient);
    return (c && c.color && c.color !== '') ? c.color : '#6c757d';
  }

  patterns.forEach((p, idx) => {
    const label = document.createElement('label');
    label.className = 'palette-btn' + (idx === 0 ? ' active' : '');
    const dotColor = getPaletteClientColor();
    label.innerHTML = `
      <input type="radio" name="palette" value="${escHtml(p.id)}" ${idx === 0 ? 'checked' : ''} style="display:none">
      <span class="palette-color-dot" style="background:${escHtml(dotColor)}"></span>
      ${escHtml(p.name)}
    `;
    label.addEventListener('click', () => {
      document.querySelectorAll('#palette .palette-btn').forEach(b => b.classList.remove('active'));
      label.classList.add('active');
      if (rawEvents.length > 0) calendar.refetchEvents();
    });
    container.appendChild(label);
  });

  const delLabel = document.createElement('label');
  delLabel.className = 'palette-btn';
  delLabel.innerHTML = `
    <input type="radio" name="palette" value="__delete__" style="display:none">
    <span class="palette-color-dot" style="background:#aaa;opacity:0.5;"></span>
    既存の予定を削除
  `;
  delLabel.addEventListener('click', () => {
    document.querySelectorAll('#palette .palette-btn').forEach(b => b.classList.remove('active'));
    delLabel.classList.add('active');
    if (rawEvents.length > 0) calendar.refetchEvents();
  });
  container.appendChild(delLabel);
}

// =====================================================================
// サイドバー描画
// =====================================================================
function renderSidebar() {
  renderClientListTo('clientList',        'filterAll');
  renderClientListTo('clientListMobile',  'filterAllMobile');
}

function renderClientListTo(listId, allCbId) {
  const container = document.getElementById(listId);
  container.innerHTML = '';

  const visibleClients = getVisibleClients();

  if (visibleClients.length === 0) {
    const msg = activeAreaId === '__all__'
      ? '会社がありません。設定から追加してください。'
      : 'このエリアに会社がありません。';
    container.innerHTML = `<div class="text-muted small p-3">${msg}</div>`;
    syncFilterAll(allCbId);
    return;
  }

  visibleClients.forEach(client => {
    const isChecked = checkedClients.has(client.name);
    const isActive  = inputModeClient === client.name;
    const rule      = clientRules[client.name];
    const clientColor = (client.color && client.color !== '') ? client.color : '#6c757d';
    // エリア名を表示
    const area = areas.find(a => a.id === client.areaId);

    const item = document.createElement('div');
    item.className = 'client-item' + (isActive ? ' input-active' : '');
    item.dataset.name = client.name;

    const cb = document.createElement('input');
    cb.type = 'checkbox';
    cb.className = 'filter-cb form-check-input';
    cb.checked = isChecked;
    cb.title = '表示/非表示';
    cb.addEventListener('change', () => {
      if (cb.checked) checkedClients.add(client.name);
      else            checkedClients.delete(client.name);
      syncFilterAll(allCbId);
      if (!inputModeClient) calendar.refetchEvents();
    });

    // 会社カラードット
    const colorDot = document.createElement('span');
    colorDot.className = 'client-color-dot';
    colorDot.style.background = clientColor;
    colorDot.title = area ? area.name : '';

    const nameWrap = document.createElement('div');
    nameWrap.className = 'client-name-wrap';

    const nameLabel = document.createElement('div');
    nameLabel.className = 'client-name-label';
    nameLabel.textContent = client.name;
    nameWrap.appendChild(nameLabel);



    item.appendChild(cb);
    item.appendChild(colorDot);
    item.appendChild(nameWrap);

    // 備考ボタン（備考がある場合のみ表示）
    if (rule) {
      const ruleBtn = document.createElement('button');
      ruleBtn.className = 'rule-info-btn';
      ruleBtn.textContent = '📋';
      ruleBtn.title = '備考を表示';
      ruleBtn.addEventListener('click', () => showInfoBar(client.name));
      item.appendChild(ruleBtn);
    }

    // 入力ボタン（権限がある場合のみ表示）
    if (canEdit(client.name)) {
      const inputBtn = document.createElement('button');
      inputBtn.className = 'input-start-btn';
      inputBtn.textContent = isActive ? '入力中' : '▶ 入力';
      inputBtn.title = isActive ? '入力モードを終了するには上の ✕ を押してください' : client.name + ' の予定を入力する';
      inputBtn.addEventListener('click', () => {
        if (isActive) return;
        enterInputMode(client.name);
      });
      item.appendChild(inputBtn);
    }

    container.appendChild(item);
  });

  syncFilterAll(allCbId);
}

function syncFilterAll(allCbId) {
  const allCb = document.getElementById(allCbId);
  if (!allCb) return;
  const visible = getVisibleClients();
  allCb.checked = visible.length > 0 && visible.every(c => checkedClients.has(c.name));
  allCb.indeterminate = !allCb.checked && visible.some(c => checkedClients.has(c.name));
}

// =====================================================================
// 入力モード
// =====================================================================
function enterInputMode(clientName) {
  if (!canEdit(clientName)) { showAlert('この会社への入力権限がありません'); return; }

  if (inputModeClient && inputModeClient !== clientName && getTotalSelectedCount() > 0) {
    showConfirm(
      `${inputModeClient} の選択中（${getTotalSelectedCount()}日）が未保存です。\n${clientName} に切り替えますか？`,
      () => _doEnterInputMode(clientName)
    );
    return;
  }
  _doEnterInputMode(clientName);
}

function _doEnterInputMode(clientName) {
  if (!inputModeClient) preInputFilters = new Set(checkedClients);

  inputModeClient = clientName;
  selectionsByPattern.clear();
  draggedDates.clear();

  // パレットのドット色を入力中の得意先カラーに更新
  buildPalette();

  document.getElementById('inputModeLabel').textContent = clientName + ' 入力モード';
  document.getElementById('inputToolbar').classList.remove('d-none');
  document.getElementById('stopInputBtn').classList.remove('d-none');
  document.getElementById('stopInputBtnMobile').classList.remove('d-none');

  // 備考は clientInfoBar に表示（ruleDisplay は使わない）
  showInfoBar(clientName);

  updateFooter();
  renderSidebar();
  calendar.refetchEvents();

  const oc = bootstrap.Offcanvas.getInstance(document.getElementById('sidebarOffcanvas'));
  if (oc) oc.hide();
}

function exitInputMode() {
  inputModeClient = null;
  selectionsByPattern.clear();
  draggedDates.clear();
  wasDragging = false;

  document.getElementById('inputToolbar').classList.add('d-none');
  document.getElementById('stickyFooter').classList.add('d-none');
  document.getElementById('stopInputBtn').classList.add('d-none');
  document.getElementById('stopInputBtnMobile').classList.add('d-none');
  hideInfoBar();

  if (preInputFilters !== null) {
    checkedClients = preInputFilters;
    preInputFilters = null;
  }

  renderSidebar();
  calendar.refetchEvents();
}

// =====================================================================
// 日付選択
// =====================================================================
function toggleDateSelection(dateStr) {
  const patId = getSelectedPatternId();
  if (!patId) return;

  if (patId === '__delete__') {
    const hasEvent = rawEvents.some(ev => {
      const p = ev.extendedProps || {};
      return !p.isHoliday && p.clientName === inputModeClient && toDateStrFromAny(ev.start) === dateStr;
    });
    if (!hasEvent) return;
    if (!selectionsByPattern.has('__delete__')) selectionsByPattern.set('__delete__', new Set());
    const delSet = selectionsByPattern.get('__delete__');
    if (delSet.has(dateStr)) {
      delSet.delete(dateStr);
    } else {
      selectionsByPattern.forEach((s, pid) => { if (pid !== '__delete__') s.delete(dateStr); });
      delSet.add(dateStr);
    }
  } else {
    const set = selectionsByPattern.get(patId);
    if (set && set.has(dateStr)) {
      set.delete(dateStr);
    } else {
      addToSelection(patId, dateStr);
    }
  }
  updateSelectedCells();
  updateFooter();
  calendar.refetchEvents();
}

function updateSelectedCells() {
  document.querySelectorAll('.fc-daygrid-day.selected-cell').forEach(el => el.classList.remove('selected-cell'));
  getAllSelectedDates().forEach(dateStr => {
    const cell = document.querySelector(`.fc-daygrid-day[data-date="${dateStr}"]`);
    if (cell) cell.classList.add('selected-cell');
  });
}

function updateDragHighlight() {
  document.querySelectorAll('.fc-daygrid-day.drag-highlight').forEach(el => el.classList.remove('drag-highlight'));
  draggedDates.forEach(dateStr => {
    const cell = document.querySelector(`.fc-daygrid-day[data-date="${dateStr}"]`);
    if (cell) cell.classList.add('drag-highlight');
  });
}

function updateFooter() {
  const n = getTotalSelectedCount();
  const footer = document.getElementById('stickyFooter');
  if (!inputModeClient || n === 0) {
    footer.classList.add('d-none');
  } else {
    footer.classList.remove('d-none');
    const parts = [];
    selectionsByPattern.forEach((set, patId) => {
      if (set.size === 0) return;
      if (patId === '__delete__') { parts.push(`削除 ${set.size}日`); return; }
      const pat = patterns.find(p => p.id === patId);
      parts.push((pat ? pat.name : '?') + ' ' + set.size + '日');
    });
    document.getElementById('selectedCount').textContent = parts.join(' / ') + ' 選択中';
  }
}

// =====================================================================
// ドラッグ選択
// =====================================================================
function setupDragSelection(calEl) {
  calEl.addEventListener('pointerdown', e => {
    if (!inputModeClient) return;
    const cell = e.target.closest('[data-date]');
    if (!cell) return;
    isDragging    = false;
    pointerDownDate = cell.dataset.date;
    draggedDates.clear();
  }, { passive: true });

  calEl.addEventListener('pointermove', e => {
    if (!pointerDownDate || !inputModeClient) return;
    const el = document.elementFromPoint(e.clientX, e.clientY);
    const cell = el && el.closest('[data-date]');
    if (!cell) return;
    const date = cell.dataset.date;
    if (!isDragging && date !== pointerDownDate) {
      isDragging = true;
      draggedDates.add(pointerDownDate);
    }
    if (isDragging && !draggedDates.has(date)) {
      draggedDates.add(date);
      updateDragHighlight();
    }
  }, { passive: true });

  document.addEventListener('pointerup', () => {
    if (!pointerDownDate) return;
    const wasD = isDragging;
    pointerDownDate = null;
    isDragging = false;

    if (wasD && draggedDates.size > 0) {
      wasDragging = true;
      const dragPatId = getSelectedPatternId();
      if (dragPatId) draggedDates.forEach(d => addToSelection(dragPatId, d));
      draggedDates.clear();
      updateDragHighlight();
      updateSelectedCells();
      updateFooter();
      calendar.refetchEvents();
      setTimeout(() => { wasDragging = false; }, 150);
    }
  });
}

// =====================================================================
// 一括選択ボタン
// =====================================================================
function localDateStr(year, month, day) {
  return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
}

function selectAllWeekends() {
  if (!inputModeClient) return;
  const patId = getSelectedPatternId();
  if (!patId || patId === '__delete__') return;
  const viewDate = calendar.getDate();
  const year = viewDate.getFullYear(), month = viewDate.getMonth();
  const daysInMonth = new Date(year, month + 1, 0).getDate();

  const targets = [];
  for (let d = 1; d <= daysInMonth; d++) {
    const dow = new Date(year, month, d).getDay();
    if (dow === 0 || dow === 6) targets.push(localDateStr(year, month, d));
  }

  const curSet = selectionsByPattern.get(patId) || new Set();
  const allSelected = targets.length > 0 && targets.every(d => curSet.has(d));
  if (allSelected) {
    targets.forEach(d => curSet.delete(d));
  } else {
    targets.forEach(d => addToSelection(patId, d));
  }

  updateSelectedCells();
  updateFooter();
  calendar.refetchEvents();
}

function selectHolidays() {
  if (!inputModeClient) return;
  const patId = getSelectedPatternId();
  if (!patId || patId === '__delete__') return;
  const viewDate = calendar.getDate();
  const year = viewDate.getFullYear(), month = viewDate.getMonth();

  const targets = [];
  holidayDates.forEach(dateStr => {
    const [y, m] = dateStr.split('-').map(Number);
    if (y === year && m - 1 === month) targets.push(dateStr);
  });

  const curSet = selectionsByPattern.get(patId) || new Set();
  const allSelected = targets.length > 0 && targets.every(d => curSet.has(d));
  if (allSelected) {
    targets.forEach(d => curSet.delete(d));
  } else {
    targets.forEach(d => addToSelection(patId, d));
  }

  updateSelectedCells();
  updateFooter();
  calendar.refetchEvents();
}

function clearSelection() {
  selectionsByPattern.clear();
  draggedDates.clear();
  updateSelectedCells();
  updateFooter();
  calendar.refetchEvents();
}

// =====================================================================
// 一括登録
// =====================================================================
function bulkRegister() {
  if (!inputModeClient || getTotalSelectedCount() === 0) return;

  const deleteDates = Array.from(selectionsByPattern.get('__delete__') || []).sort();
  const savePayloads = [];
  selectionsByPattern.forEach((dateSet, patId) => {
    if (patId === '__delete__' || dateSet.size === 0) return;
    savePayloads.push({
      clientName: inputModeClient,
      entries: Array.from(dateSet).sort().map(date => ({ date, patternId: patId }))
    });
  });

  if (savePayloads.length === 0 && deleteDates.length === 0) return;

  const lines = [];
  savePayloads.forEach(p => {
    const pat = patterns.find(x => x.id === p.entries[0].patternId);
    lines.push(`・${pat ? pat.name : '?'} → ${p.entries.length}日`);
  });
  if (deleteDates.length > 0) lines.push(`・削除 → ${deleteDates.length}日`);
  const clientForBulk = inputModeClient;

  showConfirm(
    `${clientForBulk} に以下の内容を登録しますか？\n${lines.join('\n')}`,
    () => _executeBulkRegister(clientForBulk, deleteDates, savePayloads)
  );
}

function _executeBulkRegister(clientName, deleteDates, savePayloads) {
  showLoading(true);

  const doNextSave = (idx, totalAdded, totalSkipped) => {
    if (idx >= savePayloads.length) {
      showLoading(false);
      exitInputMode();
      reloadEvents();
      const msg = `登録完了！${totalAdded}件追加${totalSkipped > 0 ? '\n（' + totalSkipped + '件は重複スキップ）' : ''}`;
      showAlert(msg);
      return;
    }
    google.script.run
      .withSuccessHandler(result => {
        if (result.status !== 'success') {
          showLoading(false);
          showAlert('登録エラー: ' + result.message);
          return;
        }
        doNextSave(idx + 1, totalAdded + result.added, totalSkipped + result.skipped);
      })
      .withFailureHandler(handleError)
      .saveHolidaysBulk(savePayloads[idx]);
  };

  if (deleteDates.length > 0) {
    google.script.run
      .withSuccessHandler(result => {
        if (result.status !== 'success') {
          showLoading(false);
          showAlert('削除エラー: ' + result.message);
          return;
        }
        doNextSave(0, 0, 0);
      })
      .withFailureHandler(handleError)
      .deleteHolidaysBulk(clientName, deleteDates);
  } else {
    doNextSave(0, 0, 0);
  }
}

