// =====================================================================
let clientDragSrc = null;

function onClientDragStart(e) {
  clientDragSrc = e.currentTarget;
  e.dataTransfer.effectAllowed = 'move';
  e.dataTransfer.setData('text/plain', clientDragSrc.dataset.id);
  setTimeout(() => { if (clientDragSrc) clientDragSrc.classList.add('dragging'); }, 0);
}

function onClientDragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  const target = e.currentTarget;
  if (!target || target === clientDragSrc) return;
  // 同じエリア内のみ許可
  if (target.closest('.sortable-list') !== clientDragSrc.closest('.sortable-list')) return;
  document.querySelectorAll('.sortable-item.drag-over-top, .sortable-item.drag-over-bottom')
    .forEach(el => el.classList.remove('drag-over-top', 'drag-over-bottom'));
  const rect = target.getBoundingClientRect();
  if (e.clientY < rect.top + rect.height / 2) {
    target.classList.add('drag-over-top');
  } else {
    target.classList.add('drag-over-bottom');
  }
}

function onClientDragLeave(e) {
  e.currentTarget.classList.remove('drag-over-top', 'drag-over-bottom');
}

function onClientDrop(e) {
  e.preventDefault();
  const target = e.currentTarget;
  if (!target || !clientDragSrc || target === clientDragSrc) return;
  if (target.closest('.sortable-list') !== clientDragSrc.closest('.sortable-list')) return;
  const rect = target.getBoundingClientRect();
  if (e.clientY < rect.top + rect.height / 2) {
    target.parentNode.insertBefore(clientDragSrc, target);
  } else {
    target.parentNode.insertBefore(clientDragSrc, target.nextSibling);
  }
  target.classList.remove('drag-over-top', 'drag-over-bottom');
}

function onClientDragEnd(e) {
  if (clientDragSrc) clientDragSrc.classList.remove('dragging');
  document.querySelectorAll('.sortable-item.drag-over-top, .sortable-item.drag-over-bottom')
    .forEach(el => el.classList.remove('drag-over-top', 'drag-over-bottom'));
  clientDragSrc = null;
}

function saveClientOrder() {
  const orders = [];
  let order = 0;
  document.querySelectorAll('#clientSettingsList .sortable-item').forEach(item => {
    orders.push({ id: item.dataset.id, order: order++ });
  });
  showLoading(true);
  google.script.run
    .withSuccessHandler(result => {
      showLoading(false);
      if (result.status === 'success') reloadClients();
      else showAlert('保存エラー: ' + result.message);
    })
    .withFailureHandler(handleError)
    .reorderClients(orders);
}

function reloadClients() {
  google.script.run
    .withSuccessHandler(data => {
      clients = data || [];
      clientRules = {};
      clients.forEach(c => { if (c.memo && c.memo.trim()) clientRules[c.name] = c.memo.trim(); });
      const clientNames = new Set(clients.map(c => c.name));
      checkedClients = new Set([...checkedClients].filter(n => clientNames.has(n)));
      clients.forEach(c => { if (!checkedClients.has(c.name)) checkedClients.add(c.name); });
      renderSidebar();
      renderClientSettings();
      // イベントの色も再取得
      reloadEvents();
    })
    .withFailureHandler(handleError)
    .getClients();
}

