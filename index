function bulkRegister() {
  if (!inputModeClient || getTotalSelectedCount() === 0) return;

  const deleteDates = Array.from(selectionsByPattern.get('__delete__') || []).sort();
  const savePayloads = [];
  selectionsByPattern.forEach((dateSet, patId) => {
    if (patId === '__delete__' || dateSet.size === 0) return;
    const cp = customPatterns.find(p => p.id === patId);
    savePayloads.push({
      clientName: inputModeClient,
      entries: Array.from(dateSet).sort().map(date => ({
        date,
        patternId: patId,
        ...(cp ? { name: cp.name } : {})
      }))
    });
  });

  if (savePayloads.length === 0 && deleteDates.length === 0) return;

  const lines = [];
  savePayloads.forEach(p => {
    const patId = p.entries[0].patternId;
    const cp = customPatterns.find(x => x.id === patId);
    const displayName = cp ? cp.name : (patterns.find(x => x.id === patId) || {}).name || '?';
    lines.push(`・${displayName} → ${p.entries.length}日`);
  });
  if (deleteDates.length > 0) lines.push(`・削除 → ${deleteDates.length}日`);
  const clientForBulk = inputModeClient;

  // 登録後に保存確認が必要な一時パターン名を収集
  const usedCustomNames = customPatterns
    .filter(cp => (selectionsByPattern.get(cp.id) || new Set()).size > 0)
    .map(cp => cp.name);

  showConfirm(
    `${clientForBulk} に以下の内容を登録しますか？\n${lines.join('\n')}`,
    () => _executeBulkRegister(clientForBulk, deleteDates, savePayloads, usedCustomNames)
  );
}

function _executeBulkRegister(clientName, deleteDates, savePayloads, usedCustomNames) {
  showLoading(true);

  const doNextSave = (idx, totalAdded, totalSkipped) => {
    if (idx >= savePayloads.length) {
      showLoading(false);
      exitInputMode();
      reloadEvents();
      const msg = `登録完了！${totalAdded}件追加${totalSkipped > 0 ? '\n（' + totalSkipped + '件は重複スキップ）' : ''}`;
      if (usedCustomNames && usedCustomNames.length > 0) {
        _askSaveCustomPattern(msg, usedCustomNames, 0);
      } else {
        showAlert(msg);
      }
      return;
    }
    google.script.run
      .withSuccessHandler(result => {
        if (result.status !== 'success') {
          showLoading(false);
          showAlert('登録エラー: ' + result.message);
          return;
        }
        doNextSave(idx + 1, totalAdded + result.added, totalSkipped + result.skipped);
      })
      .withFailureHandler(handleError)
      .saveHolidaysBulk(savePayloads[idx]);
  };

  if (deleteDates.length > 0) {
    google.script.run
      .withSuccessHandler(result => {
        if (result.status !== 'success') {
          showLoading(false);
          showAlert('削除エラー: ' + result.message);
          return;
        }
        doNextSave(0, 0, 0);
      })
      .withFailureHandler(handleError)
      .deleteHolidaysBulk(clientName, deleteDates);
  } else {
    doNextSave(0, 0, 0);
  }
}

// 自由入力パターンを順番にパターン保存確認するヘルパー
function _askSaveCustomPattern(completionMsg, names, idx) {
  if (idx >= names.length) {
    showAlert(completionMsg);
    return;
  }
  const name = names[idx];
  const msg = (idx === 0 ? completionMsg + '\n\n' : '') + `「${name}」をパターンとして保存しますか？`;

  // モーダルが完全に閉じてから次を表示（アニメーション競合を防ぐ）
  const proceed = () => _askSaveCustomPattern(completionMsg, names, idx + 1);
  document.getElementById('customConfirmModal').addEventListener('hidden.bs.modal', proceed, { once: true });

  showConfirm(
    msg,
    () => {
      google.script.run
        .withSuccessHandler(() => reloadPatterns())
        .withFailureHandler(handleError)
        .addPattern({ name, color: '#6c757d' });
    }
  );
  // キャンセル時も proceed を呼ぶ（hidden.bs.modal で自動的に呼ばれる）
}

