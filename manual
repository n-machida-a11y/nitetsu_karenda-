      <!-- 各エリア説明 -->
      <div class="row g-3">
        <div class="col-md-6">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
              <h6 class="card-title" style="color:#1565c0;">A ヘッダー</h6>
              <p class="card-text" style="font-size:0.85rem;">
                アプリ全体のタイトルバーです。
                右側に <span class="btn-label">&#x2699; 設定</span> ボタン（管理者のみ）と
                <span class="btn-label outline">? ヘルプ</span> ボタンがあります。
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card h-100 border-0 shadow-sm">
