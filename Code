  /** 操作履歴を1行記録する（内部関数） */
  function addHistory_(category, action, clientName, detail) {
    try {
      const sheet = getOrCreateSheet_(HISTORY_SHEET_NAME,
        ['操作日時', 'ユーザー名', '操作種別', '対象カテゴリ', '対象会社名', '具体的な内容']);
      const userName = (function() {
        try {
          const email = Session.getActiveUser().getEmail();
          const users = getUsers();
          const u = users.find(function(u) { return u.email.toLowerCase() === email.toLowerCase(); });
          return u ? u.name : email;
        } catch (e) { return '不明'; }
      })();
      sheet.appendRow([new Date(), userName, action, category, clientName || '', detail || '']);
    } catch (e) {
      console.error('履歴記録エラー', e);
    }
  }

  /** 操作履歴を取得する（管理者・編集者のみ） */
  function getHistory(limit) {
    try {
      const userInfo = getCurrentUserInfo();
      if (!userInfo.isAdmin && !String(userInfo.editableAreas || '').trim()) {
        return { status: 'error', message: '閲覧権限がありません' };
      }
      const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HISTORY_SHEET_NAME);
      if (!sheet || sheet.getLastRow() < 2) return { status: 'success', records: [] };
      const maxRows = Math.min(limit || 200, sheet.getLastRow() - 1);
      const startRow = Math.max(2, sheet.getLastRow() - maxRows + 1);
      const rows = sheet.getRange(startRow, 1, sheet.getLastRow() - startRow + 1, 6).getValues();
      const records = rows.filter(function(r) { return r[0]; }).map(function(r) {
        return {
          datetime: r[0] ? Utilities.formatDate(new Date(r[0]), 'JST', 'yyyy/MM/dd HH:mm:ss') : '',
          userName: String(r[1] || ''),
          action:   String(r[2] || ''),
          category: String(r[3] || ''),
          clientName: String(r[4] || ''),
          detail:   String(r[5] || '')
        };
      }).reverse();
      return { status: 'success', records: records };
    } catch (e) {
      return { status: 'error', message: e.toString() };
    }
  }

