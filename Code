  /** Patterns シートが空のときデフォルトデータを投入（公開関数兼内部関数） */
  function initDefaultPatterns() { return initDefaultPatterns_(); }
  function initDefaultPatterns_() {
    const sheet = getOrCreateSheet_(PATTERN_SHEET_NAME, ['ID', '名前', '開始時刻', '終了時刻', '色', '並び順']);
    if (sheet.getLastRow() >= 2) {
      return { status: 'already_initialized', patterns: getPatterns() };
    }
    const defaults = [
      ['', '休み',    'allday', '', '#dc3545', 1],
      ['', '午前不可', 'allday', '', '#fd7e14', 2],
      ['', '15時まで', 'allday', '', '#0d6efd', 3],
    ];
    const rows = defaults.map(d => { d[0] = Utilities.getUuid(); return d; });
    sheet.getRange(2, 3, rows.length, 2).setNumberFormat('@');
    sheet.getRange(2, 1, rows.length, 6).setValues(rows);
    const patterns = rows.map(r => ({
      id: r[0], name: r[1], startTime: r[2], endTime: r[3], color: r[4], order: r[5]
    }));
    return { status: 'success', patterns };
  }

  // =====================================================================
  // 一括保存
  // =====================================================================
  /**
  * 複数の予定を一括保存する
  * @param {{ clientName: string, entries: Array<{date: string, patternId: string}> }} payload
  * @returns {{ status: string, added: number, skipped: number }}
  */
  function saveHolidaysBulk(payload) {
    try {
      const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
      if (!sheet) return { status: 'error', message: 'Holidaysシートが見つかりません' };

      const { clientName, entries } = payload;

      // パターン ID → パターン情報
      const patternMap = {};
      getPatterns().forEach(p => { patternMap[p.id] = p; });

      // クライアントの色を取得
      const clientColorMap = {};
      getClients().forEach(c => {
        const trimmedColor = c.color.trim();
        clientColorMap[c.name] = trimmedColor !== '' ? trimmedColor : getClientColor(c.name);
      });

      // 既存の同会社日付セット（重複スキップ用）
      const existingDates = new Set();
      const lastRow = sheet.getLastRow();
      if (lastRow >= 2) {
        sheet.getRange(2, 1, lastRow - 1, 5).getValues().forEach(row => {
          if (!row[0] || String(row[4]) !== clientName) return;
          const d = row[2] ? new Date(row[2]) : null;
          if (d && !isNaN(d)) existingDates.add(Utilities.formatDate(d, 'JST', 'yyyy-MM-dd'));
        });
      }

      const newRows = [];
      let added = 0, skipped = 0;

      entries.forEach(({ date, patternId, name: customName }) => {
        // パターン名を解決（customNameが渡されている場合はそちらを優先）
        let eventName;
        if (customName) {
          eventName = customName;
        } else {
          const pattern = patternMap[patternId];
          if (!pattern) { skipped++; return; }
          eventName = pattern.name;
        }
        if (existingDates.has(date)) { skipped++; return; }

        const parts = String(date).split('-').map(Number);
        const y = parts[0], mo = parts[1] - 1, dy = parts[2];
        const startObj = new Date(Date.UTC(y, mo, dy,    -9, 0, 0));
        const endObj   = new Date(Date.UTC(y, mo, dy + 1,-9, 0, 0));

        const color = clientColorMap[clientName] || getClientColor(clientName);
        newRows.push([Utilities.getUuid(), eventName, startObj, endObj, clientName, '', color]);
        existingDates.add(date);
        added++;
      });

      if (newRows.length > 0) {
        sheet.getRange(sheet.getLastRow() + 1, 1, newRows.length, 7).setValues(newRows);
        const dateList = newRows.map(function(r) { return Utilities.formatDate(new Date(r[2]), 'JST', 'M/d'); }).join(', ');
        addHistory_('お休み予定', '一括登録', clientName, added + '件登録（' + dateList + '）');
      }
      return { status: 'success', added, skipped };
    } catch (e) {
      return { status: 'error', message: e.toString() };
    }
  }

  // =====================================================================
  // 一括削除
  // =====================================================================
  /**
  * 指定会社の指定日の予定をすべて削除する
  * @param {string} clientName
  * @param {string[]} dates  例: ['2025-01-10', '2025-01-15']
  * @returns {{ status: string, deleted: number }}
  */
  function deleteHolidaysBulk(clientName, dates) {
    try {
      const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
      if (!sheet) return { status: 'error', message: 'Holidaysシートが見つかりません' };
      const dateSet = new Set(dates);
      const lastRow = sheet.getLastRow();
      if (lastRow < 2) return { status: 'success', deleted: 0 };

      const data = sheet.getRange(2, 1, lastRow - 1, 5).getValues();
      const rowsToDelete = [];
      data.forEach((row, i) => {
        if (!row[0] || String(row[4]) !== clientName) return;
        const d = row[2] ? new Date(row[2]) : null;
        if (!d || isNaN(d)) return;
        if (dateSet.has(Utilities.formatDate(d, 'JST', 'yyyy-MM-dd'))) rowsToDelete.push(i + 2);
      });

      for (let i = rowsToDelete.length - 1; i >= 0; i--) {
        sheet.deleteRow(rowsToDelete[i]);
      }
      if (rowsToDelete.length > 0) {
        const dateList = dates.sort().map(function(d) { var p = d.split('-'); return Number(p[1]) + '/' + Number(p[2]); }).join(', ');
        addHistory_('お休み予定', '一括削除', clientName, rowsToDelete.length + '件削除（' + dateList + '）');
      }
      return { status: 'success', deleted: rowsToDelete.length };
    } catch (e) {
      return { status: 'error', message: e.toString() };
    }
  }

