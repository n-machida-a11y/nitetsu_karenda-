  /** 添付ファイル保存用Driveフォルダを取得または作成 */
  function getOrCreateAttachmentFolder_() {
    const folders = DriveApp.getFoldersByName(ATTACHMENT_FOLDER_NAME);
    if (folders.hasNext()) return folders.next();
    return DriveApp.createFolder(ATTACHMENT_FOLDER_NAME);
  }

  /** 指定会社の添付ファイル一覧を返す */
  function getAttachments(clientName) {
    try {
      const sheet = getOrCreateSheet_(ATTACHMENT_SHEET_NAME,
        ['ID', '会社名', 'ファイル名', 'DriveファイルID', 'アップロード日時', 'メモ']);
      const lastRow = sheet.getLastRow();
      if (lastRow < 2) return [];
      return sheet.getRange(2, 1, lastRow - 1, 6).getValues()
        .filter(r => r[0] && (!clientName || String(r[1]) === clientName))
        .map(r => ({
          id:         String(r[0]),
          clientName: String(r[1]),
          fileName:   String(r[2]),
          fileId:     String(r[3]),
          uploadedAt: r[4] ? Utilities.formatDate(new Date(r[4]), 'JST', 'yyyy/MM/dd HH:mm') : '',
          memo:       String(r[5] || '')
        }));
    } catch (e) {
      return [];
    }
  }

  /** 現在のユーザーが指定会社を編集できるか確認するヘルパー */
  function canEditClient_(clientName) {
    const userInfo = getCurrentUserInfo();
    if (!userInfo) return false;
    if (userInfo.isAdmin) return true;
    const editAreas = String(userInfo.editableAreas || '').split(',').map(s => s.trim()).filter(Boolean);
    if (editAreas.length === 0) return false;
    const allClients = getClients();
    const client = allClients.find(c => c.name === clientName);
    if (!client || !client.areaId) return false;
    return editAreas.includes(client.areaId);
  }

  /**
   * 添付ファイルをDriveにアップロードしてシートに記録する
   * @param {{ clientName:string, fileName:string, mimeType:string, base64Data:string, memo:string }} payload
   */
  function uploadAttachment(payload) {
    try {
      if (!canEditClient_(payload.clientName)) {
        return { status: 'error', message: 'この会社への添付ファイル追加権限がありません' };
      }
      const decoded = Utilities.base64Decode(payload.base64Data);
      const blob    = Utilities.newBlob(decoded, payload.mimeType, payload.fileName);
      const folder  = getOrCreateAttachmentFolder_();
      const file    = folder.createFile(blob);
      try {
        // ドメイン内のユーザーがリンクで閲覧可能に設定（外部共有ポリシー対応）
        file.setSharing(DriveApp.Access.DOMAIN_WITH_LINK, DriveApp.Permission.VIEW);
      } catch (e) { /* 共有設定はベストエフォート（ドメインポリシーで制限されていても続行） */ }

      const sheet = getOrCreateSheet_(ATTACHMENT_SHEET_NAME,
        ['ID', '会社名', 'ファイル名', 'DriveファイルID', 'アップロード日時', 'メモ']);
      const id = Utilities.getUuid();
      sheet.appendRow([id, payload.clientName, payload.fileName, file.getId(), new Date(), payload.memo || '']);
      addHistory_('添付ファイル', '追加', payload.clientName, '「' + payload.fileName + '」をアップロード');
      return { status: 'success', id: id, fileId: file.getId(), fileName: payload.fileName };
    } catch (e) {
      return { status: 'error', message: e.toString() };
    }
  }

  /** 添付ファイルをシートとDriveから削除する */
  function deleteAttachment(id) {
    try {
      const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(ATTACHMENT_SHEET_NAME);
      if (!sheet) return { status: 'error', message: 'シートが見つかりません' };
      const lastRow = sheet.getLastRow();
      if (lastRow < 2) return { status: 'error', message: '見つかりません' };
      const rows = sheet.getRange(2, 1, lastRow - 1, 4).getValues();
      for (let i = 0; i < rows.length; i++) {
        if (String(rows[i][0]) === String(id)) {
          // 削除前に会社名で権限チェック（列2 = 会社名）
          const clientName = String(rows[i][1]);
          if (!canEditClient_(clientName)) {
            return { status: 'error', message: 'この会社への添付ファイル削除権限がありません' };
          }
          const fileId = String(rows[i][3]);
          const fileName = String(rows[i][2]);
          try { DriveApp.getFileById(fileId).setTrashed(true); } catch (e) { /* 既に存在しない場合は無視 */ }
          sheet.deleteRow(i + 2);
          addHistory_('添付ファイル', '削除', clientName, '「' + fileName + '」を削除');
          return { status: 'success' };
        }
      }
      return { status: 'error', message: '見つかりません' };
    } catch (e) {
      return { status: 'error', message: e.toString() };
    }
  }
