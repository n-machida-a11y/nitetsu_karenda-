  /** 会社名ハッシュから一貫した色を生成 */
  function getClientColor(clientName) {
    if (!clientName) return '#6c757d';
    let hash = 0;
    for (let i = 0; i < clientName.length; i++) {
      hash = clientName.charCodeAt(i) + ((hash << 5) - hash);
    }
    return `hsl(${Math.abs(hash % 360)}, 70%, 45%)`;
  }

  /**
  * Date → FullCalendar 用文字列
  * JST 00:00:00 → 'yyyy-MM-dd'
  * その他       → 'yyyy-MM-ddTHH:mm:ss+09:00'
  */
  function formatEventDate_(d) {
    if (!d) return null;
    const obj = new Date(d);
    if (isNaN(obj.getTime())) return null;
    const t = Utilities.formatDate(obj, 'JST', 'HH:mm:ss');
    if (t === '00:00:00') {
      return Utilities.formatDate(obj, 'JST', 'yyyy-MM-dd');
    }
    return Utilities.formatDate(obj, 'JST', "yyyy-MM-dd'T'HH:mm:ss") + '+09:00';
  }

  /** シートを取得、なければ新規作成してヘッダーを入れる */
  function getOrCreateSheet_(name, headers) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let sheet = ss.getSheetByName(name);
    if (!sheet) {
      sheet = ss.insertSheet(name);
      sheet.appendRow(headers);
      sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
    }
    return sheet;
  }

