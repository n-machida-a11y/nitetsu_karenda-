  /**
  * Sheets が 'HH:mm' を時刻型に自動変換することがあるため、
  * セル値（文字列 / Date / 数値）を安全に 'HH:mm' または 'allday' に変換する
  */
  function timeFromCell_(val) {
    if (val === null || val === undefined || val === '') return 'allday';
    if (typeof val === 'string') {
      const s = val.trim();
      return s === '' ? 'allday' : s;
    }
    if (val instanceof Date) {
      return Utilities.formatDate(val, 'JST', 'HH:mm');
    }
    if (typeof val === 'number') {
      const totalMins = Math.round(val * 24 * 60);
      return String(Math.floor(totalMins / 60)).padStart(2, '0') + ':' + String(totalMins % 60).padStart(2, '0');
    }
    return String(val);
  }

  function getPatterns() {
    try {
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      const sheet = ss.getSheetByName(PATTERN_SHEET_NAME);
      if (!sheet) return initDefaultPatterns_().patterns;
      const lastRow = sheet.getLastRow();
      if (lastRow < 2) return [];
      return sheet.getRange(2, 1, lastRow - 1, 6).getValues()
        .filter(r => r[0])
        .map(r => {
          const st = timeFromCell_(r[2]);
          const et = timeFromCell_(r[3]);
          return {
            id:        String(r[0]),
            name:      String(r[1]),
            startTime: st,
            endTime:   (et === 'allday' ? '' : et),
            color:     String(r[4] || '#6c757d'),
            order:     Number(r[5]) || 99
          };
        })
        .sort((a, b) => a.order - b.order);
    } catch (e) {
      console.error('getPatterns error', e);
      return [];
    }
  }

