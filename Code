  // =====================================================================
  // 休日イベント取得（得意先色対応版）
  // =====================================================================
  function getHolidays() {
    try {
      const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
      if (!sheet) return [];

      // クライアントの色マップを作成（設定色 > 自動生成色）
      const clientColorMap = {};
      getClients().forEach(c => {
        const trimmedColor = c.color.trim();
        clientColorMap[c.name] = trimmedColor !== '' ? trimmedColor : getClientColor(c.name);
      });

      let holidays = [];
      const lastRow = sheet.getLastRow();
      if (lastRow >= 2) {
        const data = sheet.getRange(2, 1, lastRow - 1, 7).getValues();
        holidays = data.map(row => {
          if (!row[0]) return null;
          const startStr = formatEventDate_(row[2]);
          const endStr   = formatEventDate_(row[3]);
          if (!startStr) return null;
          const clientName = String(row[4] || '');
          // 優先順位: Clients設定色 > HolidaysシートG列の保存色 > ハッシュ自動生成色
          const savedColor = String(row[6] || '').trim();
          const color = clientColorMap[clientName] || (savedColor !== '' ? savedColor : getClientColor(clientName));
          return {
            id:              String(row[0]),
            title:           String(row[1]),
            start:           startStr,
            end:             endStr,
            extendedProps:   { clientName },
            backgroundColor: color,
            borderColor:     color
          };
        }).filter(Boolean);
      }
      return [...holidays, ...getJapaneseHolidays()];
    } catch (e) {
      throw new Error('データの取得に失敗しました: ' + e.message);
    }
  }

