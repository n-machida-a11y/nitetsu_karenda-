/**
 * 「確認と修正」シートの内容を「Holidays」シートへ転記する
 * 完了後に「確認と修正」シートを自動クリアする
 */
function appendDataToHolidays() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  const sourceSheet = spreadsheet.getSheetByName('確認と修正');
  const destinationSheet = spreadsheet.getSheetByName('Holidays');

  if (!destinationSheet) {
    SpreadsheetApp.getUi().alert('「Holidays」シートが見つかりません。');
    return;
  }

  const sourceData = sourceSheet.getDataRange().getValues();
  if (sourceData.length <= 1) {
    SpreadsheetApp.getUi().alert('「確認と修正」シートに転記するデータがありませんでした。');
    return;
  }

  const dataToAppend = sourceData.slice(1); // ヘッダー除外
  const destLastRow = destinationSheet.getLastRow();
  
  // ★変更点: 既存データを「日付_得意先_件名」のキーで管理するためのマップを作成
  let existingKeyMap = {}; // Key: "YYYY-MM-DD_Client_Title", Value: {row: 行番号, id: ID}
  
  if (destLastRow >= 2) {
    // ID, Title, Start, End, Client, Category, Color
    const existingData = destinationSheet.getRange(2, 1, destLastRow - 1, 7).getValues();
    
    existingData.forEach((row, index) => {
      const id = row[0];
      const title = row[1];
      const start = row[2];
      const client = row[4];
      
      // キーを生成 (日付変換含む)
      const key = generateUniqueKey(start, client, title);
      if (key) {
        existingKeyMap[key] = { row: index + 2, id: id };
      }
    });
  }

  let newCount = 0;
  let updateCount = 0;

  dataToAppend.forEach(row => {
    // 転記データの情報を取得
    // [0:id, 1:title, 2:start, 3:end, 4:client, 5:category, 6:color]
    let id = row[0].toString();
    const title = row[1];
    const start = row[2];
    const client = row[4];

    // 今回追加するデータのキーを生成
    const key = generateUniqueKey(start, client, title);

    if (key && existingKeyMap[key]) {
      // ★重複あり: 既存の行を更新する
      const existingInfo = existingKeyMap[key];
      const targetRowNum = existingInfo.row;
      
      // IDが変わってしまうのを防ぐため、既存のIDを維持する（あるいは新しいIDで上書きするかはお好みですが、維持が安全です）
      row[0] = existingInfo.id; 
      
      destinationSheet.getRange(targetRowNum, 1, 1, row.length).setValues([row]);
      updateCount++;
    } else {
      // ★重複なし: 新規追加
      // IDが空なら生成しておく
      if (!id) {
        row[0] = Utilities.getUuid();
      }
      destinationSheet.appendRow(row);
      newCount++;
    }
  });

  // 処理完了後に「確認と修正」シートを自動クリア
  sourceSheet.clear();

  // 完了メッセージ（リンク付き）
  const appUrl = 'https://script.google.com/a/macros/nittetuman.co.jp/s/AKfycby2ERvedfVcjm_aqFwT_s0ddy5hfb4se4QvfW5usGpmfXnqQiZ85XJvRcYN1maMyqzUFg/exec';
  
  const htmlContent = `
    <div style="font-family: sans-serif; padding: 10px;">
      <p style="font-size: 14px;">カレンダーに反映されました。<br>下記URLからご確認ください。</p>
      <p style="margin: 10px 0; font-weight: bold; color: #444;">新規登録: ${newCount}件 / 更新: ${updateCount}件</p>
      <p><a href="${appUrl}" target="_blank" style="font-weight: bold; font-size: 16px; color: #1a73e8; text-decoration: none;">👉 カレンダーを開く</a></p>
      <p style="font-size: 10px; color: #666; word-break: break-all; margin-top: 5px;">${appUrl}</p>
      <div style="text-align: right; margin-top: 20px;">
        <input type="button" value="閉じる" onclick="google.script.host.close()" 
               style="background-color: #f1f3f4; border: 1px solid transparent; border-radius: 4px; padding: 8px 16px; font-size: 14px; cursor: pointer;" />
      </div>
    </div>
  `;

  const htmlOutput = HtmlService.createHtmlOutput(htmlContent)
    .setWidth(450)
    .setHeight(320);

  SpreadsheetApp.getUi().showModalDialog(htmlOutput, '処理完了');
}

/**
 * 重複チェック用のユニークキーを生成するヘルパー関数
 * 形式: YYYY-MM-DD_ClientName_Title
 */
function generateUniqueKey(dateVal, clientName, title) {
  if (!dateVal) return null;
  
  // 日付を YYYY-MM-DD 形式の文字列に変換
  let dateStr = "";
  if (dateVal instanceof Date) {
    dateStr = Utilities.formatDate(dateVal, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  } else {
    // 文字列の場合、日付としてパースできるか試みる（YYYY-MM-DDやYYYY/MM/DD想定）
    const d = new Date(dateVal);
    if (!isNaN(d.getTime())) {
      dateStr = Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd');
    } else {
      return null; // 日付が無効ならキー生成不可
    }
  }

  const safeClient = (clientName || "").toString().trim();
  const safeTitle = (title || "").toString().trim();
  
  return `${dateStr}_${safeClient}_${safeTitle}`;
}
